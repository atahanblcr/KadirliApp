# Faz 12.21a — docker-compose.prod.yml'in ortam şablonu.
#
#   cp .env.prod.example .env   →  doldurun  →  docker compose -f docker-compose.prod.yml up -d
#
# 🔴 `.env` GİT'E GİRMEZ (.gitignore). Bu dosya YER TUTUCUDUR: içine gerçek bir sır
# yazan kişi onu herkese açık bir depoya commit etmiş olur (11.18'de birebir yaşandı).
# Buradaki hiçbir değer "çalışan bir varsayılan" değildir; hepsi bilinçli olarak sahte.

# ── Veritabanı ───────────────────────────────────────────────────────────────
POSTGRES_USER=kadirliapp
POSTGRES_PASSWORD=DEGISTIR_guclu_bir_parola
POSTGRES_DB=kadirliapp

# ── JWT ──────────────────────────────────────────────────────────────────────
# ⚠️ En az 32 karakter. appsettings.json'daki geliştirme değerleri YANMIŞ sayılır
# (depo herkese açık) ve ProductionReadinessGuard onlarla açılışı durdurur.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=DEGISTIR_en_az_32_karakterlik_rastgele_bir_deger
JWT_REFRESH_SECRET=DEGISTIR_farkli_ve_en_az_32_karakterlik_bir_deger

# ── SMS ──────────────────────────────────────────────────────────────────────
# 🔴 YAYIN ÖNCESİ TEK GERÇEK BLOKAJ. Bugün projede yalnız `Dev` adaptörü GERÇEKLENMİŞ
# durumda (log'a yazar) ve Production'da iki kapı birbirini kilitliyor:
#   Sms__Provider=Dev            → ProductionReadinessGuard açılışı durdurur
#   Sms__Provider=<başka bir şey> → AddInfrastructure "Bilinmeyen SMS sağlayıcısı" fırlatır
# Yani API bugün Production'da AÇILAMAZ ve bu DOĞRU davranıştır: SMS olmadan hiç kimse
# giriş yapamaz. Gerçek sağlayıcı `ISmsService` olarak yazılıp
# `Infrastructure/DependencyInjection.cs`'e kaydedilmeli (12.21 raporuna bakın).
SMS_PROVIDER=DEGISTIR_gercek_saglayici_adi

# ── E-posta (şüpheli giriş uyarıları) ────────────────────────────────────────
# `Smtp` seçilirse Email__Smtp__* ayarları da gerekir. Uyarıyı bilinçli olarak
# kapatmak isterseniz: EMAIL_PROVIDER=Dev + SECURITY_ALERT_EMAIL_ENABLED=false
# (guard yalnız "açık ama sağlayıcı Dev" bileşimini engelliyor — o bileşim
# uyarıların hiç kimseye gitmediği ve bunu kimsenin bilmediği hâldir).
EMAIL_PROVIDER=Smtp
SECURITY_ALERT_EMAIL_ENABLED=true

# ── Hangfire panosu ──────────────────────────────────────────────────────────
# ⚠️ Boş bırakılamaz: pano "yalnız yerel istekler" kuralına dayanıyor ve ters vekil
# arkasında HER istek yerel görünür → /hangfire fiilen herkese açık olur.
HANGFIRE_USER=DEGISTIR
HANGFIRE_PASSWORD=DEGISTIR_guclu_bir_parola

# ── Ters vekil ───────────────────────────────────────────────────────────────
# ⚠️ Boş bırakılamaz: ForwardedHeaders açıkken güvenilen ağ yoksa istemci kendi
# X-Forwarded-For'unu uydurup giriş denemesi kaydını ZEHİRLER.
TRUSTED_PROXY_NETWORK=10.0.0.0/8

# ── Seq (log sunucusu) ───────────────────────────────────────────────────────
# Hash üretimi:  docker run --rm datalust/seq config hash <parola>
SEQ_ADMIN_PASSWORD_HASH=DEGISTIR_seq_config_hash_ciktisi
SEQ_API_KEY=DEGISTIR_seq_arayuzunden_uretilen_api_key

# ── Ortam ────────────────────────────────────────────────────────────────────
# ⚠️ Boş bırakın = Production. Yalnız ön-üretim (Staging) kurulumunda değiştirin;
# 🔴 Staging'de ProductionReadinessGuard KOŞMAZ, yani yayın kapısı kapanır.
# API_ENVIRONMENT=Production

# ── İmaj / port ──────────────────────────────────────────────────────────────
# ⚠️ IMAGE_TAG için `latest` KULLANMAYIN: hangi sürümün canlıda olduğunu söyleyemez
# ve geri alma yolunu kapatır. CD hattı commit SHA'sı ile etiketliyor.
IMAGE_REGISTRY=ghcr.io/atahanblcr/kadirliapp
IMAGE_TAG=DEGISTIR_commit_sha
API_PORT=8080
WEB_PORT=8081
