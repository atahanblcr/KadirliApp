<script nonce="@Context.Items["csp-nonce"]">
    // ================= Mekan formu ortak scriptleri =================
    // Konum
    initLocationPicker('locationMap', 'latInput', 'lngInput', null);

    // ---- Açılış/Kapanış saatleri: gizli OpeningHours <-> time inputları ----
    (function initHours() {
        var raw = document.getElementById('openingHours').value || '';
        if (/7\s*\/\s*24|24 saat|her zaman/i.test(raw)) {
            document.getElementById('alwaysOpen').checked = true;
            toggleAlwaysOpen();
            return;
        }
        var m = raw.match(/(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})/);
        if (m) {
            document.getElementById('openTime').value = m[1].padStart(2, '0') + ':' + m[2];
            document.getElementById('closeTime').value = m[3].padStart(2, '0') + ':' + m[4];
        }
    })();

    function toggleAlwaysOpen() {
        var always = document.getElementById('alwaysOpen').checked;
        document.getElementById('openTime').disabled = always;
        document.getElementById('closeTime').disabled = always;
    }

    // ---- Olanaklar (amenities) ----
    var defaultAmenities = ['WC', 'Wi-Fi', 'Klima', 'Otopark', 'Engelli Erişimi', 'Çocuk Oyun Alanı'];
    // state: { "WC": true/false } — belirtilmeyenler objede yer almaz
    var amenityState = {};
    (function initAmenities() {
        var raw = document.getElementById('amenitiesJson').value;
        if (raw) {
            try { amenityState = JSON.parse(raw) || {}; } catch (e) { amenityState = {}; }
        }
        var names = defaultAmenities.slice();
        Object.keys(amenityState).forEach(function (k) {
            if (names.indexOf(k) === -1) names.push(k);
        });
        names.forEach(renderAmenityRow);
    })();

    function renderAmenityRow(name) {
        var list = document.getElementById('amenityList');
        var row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-2 bg-gray-50 border border-gray-200 rounded-lg px-3 py-2';
        row.dataset.amenity = name;

        var label = document.createElement('span');
        label.className = 'text-sm text-gray-700 truncate';
        label.textContent = name;

        var btns = document.createElement('div');
        btns.className = 'flex gap-1 shrink-0';

        ['Var', 'Yok'].forEach(function (opt) {
            var b = document.createElement('button');
            b.type = 'button';
            b.textContent = opt;
            b.className = 'amenity-btn text-xs px-2.5 py-1 rounded-md border transition-colors';
            b.dataset.value = (opt === 'Var');
            b.addEventListener('click', function () {
                var val = (opt === 'Var');
                if (amenityState[name] === val) delete amenityState[name]; // tekrar tıklayınca "belirtilmedi"
                else amenityState[name] = val;
                refreshAmenityRow(row, name);
            });
            btns.appendChild(b);
        });

        row.appendChild(label);
        row.appendChild(btns);
        list.appendChild(row);
        refreshAmenityRow(row, name);
    }

    function refreshAmenityRow(row, name) {
        row.querySelectorAll('.amenity-btn').forEach(function (b) {
            var isVar = b.dataset.value === 'true';
            var active = amenityState.hasOwnProperty(name) && amenityState[name] === isVar;
            if (active && isVar) b.className = 'amenity-btn text-xs px-2.5 py-1 rounded-md border transition-colors bg-green-600 text-white border-green-600';
            else if (active && !isVar) b.className = 'amenity-btn text-xs px-2.5 py-1 rounded-md border transition-colors bg-red-500 text-white border-red-500';
            else b.className = 'amenity-btn text-xs px-2.5 py-1 rounded-md border transition-colors bg-white text-gray-500 border-gray-300 hover:border-gray-400';
        });
    }

    function addAmenity() {
        var input = document.getElementById('newAmenityName');
        var name = input.value.trim();
        if (!name) return;
        var exists = document.querySelector('#amenityList [data-amenity="' + CSS.escape(name) + '"]');
        if (!exists) {
            renderAmenityRow(name);
            amenityState[name] = true; // yeni eklenen özellik varsayılan "Var"
            refreshAmenityRow(document.querySelector('#amenityList [data-amenity="' + CSS.escape(name) + '"]'), name);
        }
        input.value = '';
    }


    // ---- Submit: gizli alanları doldur ----
    function preparePlaceForm() {
        var lat = document.getElementById('latInput').value;
        var lng = document.getElementById('lngInput').value;

        // 🐛 Faz 12.9 canlı denetiminde bulundu (12.9 kapsamı DIŞI, önceden var olan hata).
        // Önceki koşul `!lat || !lng` idi ve YENİ KAYIT formunda hiç tetiklenmiyordu:
        // `CreatePlaceCommand.Latitude` **decimal** (nullable değil), yani `asp-for`
        // alana `value="0"` basıyor ve `"0"` JavaScript'te **truthy**. HTML'deki
        // `required` de aynı sebeple geçiyordu (alan boş değil, "0").
        //
        // Sonuç tam olarak bu projenin "sessiz hasar" dediği sınıftı: form
        // **"Konum *"** diyor, kapı **var**, kapı **hiç çalışmıyor** — mekan
        // 0,0'a (Gine Körfezi, Afrika açıkları) kaydediliyor ve mobildeki
        // "Konuma Git" vatandaşı oraya götürüyor. Ne hata, ne log, ne uyarı.
        //
        // Kadirli 37.37 / 36.09'da; 0 bu alanlar için hiçbir zaman geçerli bir
        // değer değil, "işaretlenmedi" demek.
        var isaretlenmedi = function (v) {
            var n = parseFloat((v || '').replace(',', '.'));
            return isNaN(n) || n === 0;
        };

        if (isaretlenmedi(lat) || isaretlenmedi(lng)) {
            alert('Lütfen haritaya tıklayarak mekanın konumunu işaretleyin.');
            return false;
        }

        if (document.getElementById('alwaysOpen').checked) {
            document.getElementById('openingHours').value = '7/24 Açık';
        } else {
            var open = document.getElementById('openTime').value;
            var close = document.getElementById('closeTime').value;
            document.getElementById('openingHours').value = (open && close) ? (open + ' - ' + close) : '';
        }

        document.getElementById('amenitiesJson').value =
            Object.keys(amenityState).length ? JSON.stringify(amenityState) : '';
        return true;
    }

    // ————————————————————————————————————————————————————————————
    // Faz 12.9 — bağlamalar satır içi on*= özniteliğinden BURAYA taşındı.
    // CSP `script-src 'self' 'nonce-…'` ile kurulu ve `unsafe-inline` YOK;
    // nonce yalnız script BLOKLARINI kapsar, öznitelikleri kapsamaz.
    // ————————————————————————————————————————————————————————————

    document.querySelector('[data-always-open]')?.addEventListener('change', toggleAlwaysOpen);
    document.querySelector('[data-add-amenity]')?.addEventListener('click', addAmenity);
    // ⚠️ Eski hâl `onsubmit="return preparePlaceForm()"` idi: false dönmek gönderimi
    // iptal ediyordu. addEventListener'da `return false` bir şey yapmaz — iptal
    // AÇIKÇA preventDefault() ile yapılmalı. Bu fark sessizdir: dönüştürme sırasında
    // atlanırsa konumsuz form doğrulamayı geçmiş gibi POST edilirdi.
    document.querySelector('[data-place-form]')?.addEventListener('submit', function (e) {
        if (preparePlaceForm() === false) e.preventDefault();
    });
</script>
