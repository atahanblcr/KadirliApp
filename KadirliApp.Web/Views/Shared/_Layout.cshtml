@using KadirliApp.Web.Common
@inject IPanelMenuProvider MenuProvider
@inject IWebHostEnvironment PanelEnvironment
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KadirliApp Yönetim</title>
    @*
        Faz 12.9 — panelin görsel bağımlılıkları YERELDİR.
        Önceki hâl: Tailwind cdn.tailwindcss.com'dan (üstelik tarayıcı-içi JIT
        derleyicisi olarak — kendi dokümantasyonu production'da kullanmayın diyor),
        ikonlar cdnjs'ten. İkisi de super_admin oturumu açık bir tarayıcıda sınırsız
        JavaScript çalıştırıyordu, hiçbirinde SRI yoktu ve ağ kesildiğinde panel
        tamamen stilsiz açılıyordu. Artık dış origin YOK — yapısal test denetliyor
        (PanelExternalOriginTests).
        ⚠️ asp-append-version: panel.css TÜRETİLMİŞ ve COMMİT EDİLMİŞ bir dosya;
        içeriği değiştiğinde adı da değişmezse yöneticinin tarayıcısı eski stili
        günlerce önbellekte tutar ve "bende düzelmedi" diye görünür.
    *@
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
</head>
<body class="bg-gray-100 text-gray-800 font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
        <partial name="_Sidebar" />
        
        <div class="relative flex flex-col flex-1 overflow-y-auto overflow-x-hidden">
            <header class="sticky top-0 bg-white border-b border-gray-200 z-30">
                <div class="px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between h-16 -mb-px">
                        @*
                            Faz 11.15c — DAR EKRAN MENÜSÜ.
                            Önceki hâlde buradaki buton bir kabuktu: id/onclick/data-* yoktu ve
                            panelde onu bağlayan JS de yoktu; kenar çubuğu "hidden lg:flex" olduğu
                            için <1024 px'de modüller arası TEK geçiş yolu adres çubuğuydu.
                            (Mobildeki "işlevsiz buton yok" kuralının panel ihlaliydi.)

                            Çözüm JS'siz <details>/<summary> ile: panelin başka yerinde de
                            kullanılan desen (AdsAdmin red popover'ı). JS olmadığı için
                            "menü açılıyor mu" sorusu sunucu tarafı render testiyle
                            denetlenebiliyor — bağlantılar işaretlemede GERÇEKTEN var.
                        *@
                        <div class="flex lg:hidden">
                            <details class="relative" id="panel-mobile-menu">
                                <summary class="list-none cursor-pointer text-gray-500 hover:text-gray-600 p-2 -ml-2"
                                         aria-label="Menüyü aç">
                                    <i class="fas fa-bars text-xl" aria-hidden="true"></i>
                                </summary>
                                <nav aria-label="Menü"
                                     class="absolute left-0 z-40 mt-2 w-72 max-h-[80vh] overflow-y-auto rounded-lg bg-gray-900 p-3 shadow-2xl">
                                    <partial name="_MenuLinks" model="await MenuProvider.VisibleItemsAsync(User)" />
                                    <hr class="my-3 border-gray-700" />
                                    <partial name="_AccountLinks" />
                                </nav>
                            </details>
                        </div>
                        @*
                            Faz 11.16b — GLOBAL ARAMA kutusu.
                            Menüde satırı yok, giriş noktası burası: yöneticinin elindeki ipucu
                            genelde modülü değil kaydı tarif eder ("Yılmaz diye bir şey vardı"),
                            önce doğru listeyi bulmak zorunda kalmak panelin en sık tekrarlanan
                            gereksiz adımıydı.
                            ⚠️ Üst çubukta olması dar ekranda da erişilebilir olmasını sağlıyor
                            (kenar çubuğu <1024 px'de gizli — 11.15c'nin dersi).
                        *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="GlobalSearch" asp-action="Index" method="get"
                                  class="flex-1 max-w-md mx-4" role="search">
                                <label for="panel-global-search" class="sr-only">Panelde ara</label>
                                <div class="relative">
                                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm" aria-hidden="true"></i>
                                    <input id="panel-global-search" type="search" name="q"
                                           value="@(Context.Request.Query["q"])"
                                           placeholder="Panelde ara…"
                                           class="w-full rounded-lg border border-gray-300 bg-gray-50 py-1.5 pl-9 pr-3 text-sm focus:border-indigo-500 focus:bg-white focus:ring-indigo-500" />
                                </div>
                            </form>
                        }
                        <div class="flex items-center space-x-3">
                            @*
                                ➕ Faz 12.19a (plan dışı) — ORTAM ROZETİ.
                                Panel, geri alınamaz ve şehir ölçekli işlerin yapıldığı yer:
                                bütün şehre push atmak, hukuki metin YAYINLAMAK, vefat ilanı
                                onaylamak. Buna karşılık 12.19a'ya kadar ekranda "burası hangi
                                kurulum?" sorusunu cevaplayan HİÇBİR ŞEY yoktu — geliştirme
                                paneli ile canlı panel piksel piksel aynı görünüyordu.
                                🔑 Rozet YALNIZ Production DIŞINDA çizilir ve yön bilinçli:
                                "CANLI" yazan bir rozet, unutulduğu ya da yanlış yapılandırıldığı
                                anda canlıyı GÜVENLİ gösterirdi (rozet yok → "demek ki dev").
                                Ters yönde ise en kötü ihtimalle geliştirme paneli süslenmemiş
                                kalır — sessiz hasar üretmeyen tek yön bu.
                            *@
                            @if (!PanelEnvironment.IsProduction())
                            {
                                <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800"
                                      title="Bu panel canlı ortam DEĞİL — @PanelEnvironment.EnvironmentName">
                                    <i class="fas fa-flask mr-1" aria-hidden="true"></i>@PanelEnvironment.EnvironmentName
                                </span>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <span class="text-sm text-gray-500"><i class="fas fa-user-circle mr-1.5"></i>@User.Identity.Name</span>
                                <span class="text-gray-300">|</span>
                            }
                            <span class="text-sm font-medium text-gray-700">Admin Panel</span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-grow w-full max-w-9xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                @*
                    Panel bildirim balonlarının TEK yeri. View'lar bunları kendileri BASMAZ —
                    controller yalnızca TempData["Success"] / TempData["Error"] kurar.
                    ⚠️ TempData key'leri harf DUYARSIZDIR (TempDataDictionary OrdinalIgnoreCase):
                    burada "error", view'da "Error" yazmak aynı kaydı İKİ kez bastırıyordu.
                *@
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="flex items-start gap-2 p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 shadow-sm" role="alert">
                        <i class="fas fa-check-circle mt-0.5"></i>
                        <span>@successMessage</span>
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="flex items-start gap-2 p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 shadow-sm" role="alert">
                        <i class="fas fa-exclamation-circle mt-0.5"></i>
                        <span>@errorMessage</span>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @*
        Faz 12.9 — panelin ortak davranışı artık HARİCİ bir dosyada (wwwroot/js/panel.js).
        Buradaki blok CSP nonce'u ile de çalışabilirdi; harici dosyaya taşınmasının
        sebebi CSP değil, aynı davranışın görünümlerden de çağrılabilmesi ve
        tarayıcı önbelleğine girebilmesi.
    *@
    <script src="~/js/panel.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
