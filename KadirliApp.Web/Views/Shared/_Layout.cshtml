@using KadirliApp.Web.Common
@inject IPanelMenuProvider MenuProvider
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KadirliApp Yönetim</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
</head>
<body class="bg-gray-100 text-gray-800 font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
        <partial name="_Sidebar" />
        
        <div class="relative flex flex-col flex-1 overflow-y-auto overflow-x-hidden">
            <header class="sticky top-0 bg-white border-b border-gray-200 z-30">
                <div class="px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between h-16 -mb-px">
                        @*
                            Faz 11.15c — DAR EKRAN MENÜSÜ.
                            Önceki hâlde buradaki buton bir kabuktu: id/onclick/data-* yoktu ve
                            panelde onu bağlayan JS de yoktu; kenar çubuğu "hidden lg:flex" olduğu
                            için <1024 px'de modüller arası TEK geçiş yolu adres çubuğuydu.
                            (Mobildeki "işlevsiz buton yok" kuralının panel ihlaliydi.)

                            Çözüm JS'siz <details>/<summary> ile: panelin başka yerinde de
                            kullanılan desen (AdsAdmin red popover'ı). JS olmadığı için
                            "menü açılıyor mu" sorusu sunucu tarafı render testiyle
                            denetlenebiliyor — bağlantılar işaretlemede GERÇEKTEN var.
                        *@
                        <div class="flex lg:hidden">
                            <details class="relative" id="panel-mobile-menu">
                                <summary class="list-none cursor-pointer text-gray-500 hover:text-gray-600 p-2 -ml-2"
                                         aria-label="Menüyü aç">
                                    <i class="fas fa-bars text-xl" aria-hidden="true"></i>
                                </summary>
                                <nav aria-label="Menü"
                                     class="absolute left-0 z-40 mt-2 w-72 max-h-[80vh] overflow-y-auto rounded-lg bg-gray-900 p-3 shadow-2xl">
                                    <partial name="_MenuLinks" model="await MenuProvider.VisibleItemsAsync(User)" />
                                    <hr class="my-3 border-gray-700" />
                                    <partial name="_AccountLinks" />
                                </nav>
                            </details>
                        </div>
                        <div class="flex items-center space-x-3">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <span class="text-sm text-gray-500"><i class="fas fa-user-circle mr-1.5"></i>@User.Identity.Name</span>
                                <span class="text-gray-300">|</span>
                            }
                            <span class="text-sm font-medium text-gray-700">Admin Panel</span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-grow w-full max-w-9xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                @*
                    Panel bildirim balonlarının TEK yeri. View'lar bunları kendileri BASMAZ —
                    controller yalnızca TempData["Success"] / TempData["Error"] kurar.
                    ⚠️ TempData key'leri harf DUYARSIZDIR (TempDataDictionary OrdinalIgnoreCase):
                    burada "error", view'da "Error" yazmak aynı kaydı İKİ kez bastırıyordu.
                *@
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="flex items-start gap-2 p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 shadow-sm" role="alert">
                        <i class="fas fa-check-circle mt-0.5"></i>
                        <span>@successMessage</span>
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="flex items-start gap-2 p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 shadow-sm" role="alert">
                        <i class="fas fa-exclamation-circle mt-0.5"></i>
                        <span>@errorMessage</span>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Faz 11.15c — silme/geri alınamaz aksiyonlar için ORTAK onay.
        //
        // Önceki hâl: 21 ayrı görünümde inline onsubmit="return confirm('… emin misiniz?')".
        // İki sorunu vardı: (1) hiçbiri NEYİN silindiğini yazmıyordu, yanlış satırı silmek
        // kolaydı; (2) kayıt adını inline JS dizesine gömmek kırılgan — Razor öznitelikleri
        // HTML-encode ettiği için tırnak içeren bir başlık ("Ali'nin arabası") JS dizesini
        // bozuyordu. data-confirm özniteliği bu sorunun ikisini birden çözer: metin
        // öznitelikte güvenle taşınır, buradan getAttribute ile okunur.
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!form || !form.hasAttribute || !form.hasAttribute('data-confirm')) return;
            if (!window.confirm(form.getAttribute('data-confirm'))) {
                e.preventDefault();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
