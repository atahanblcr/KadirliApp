@*
    Faz 12.9 — Leaflet artık YEREL (wwwroot/lib/leaflet).

    🔴 Bu partial duyuru · vefat · rehber · etkinlik · mekan formlarının HEPSİNDE
    kullanılıyor (Create + Edit = 10 görünüm). 12.9 öncesinde CSS ve JS unpkg.com'dan
    geliyordu ve o origin erişilemediğinde `L.` çağrıları `undefined` üzerinde
    patlıyordu: yönetici BOŞ BİR KUTU görüyor, koordinat seçemiyor ve ekranda
    hiçbir hata mesajı çıkmıyordu. "İşlevsiz buton yok" kuralının panel karşılığı,
    ağ kesildiği anda sessizce ihlal oluyordu.

    ⚠️ Harita KARELERİ (tile) hâlâ dışarıdan geliyor ve bu kaçınılmaz: bir dünya
    haritasının görüntüsü self-host edilemez. Ama ikisi AYNI ŞEY DEĞİL ve fark
    tam olarak bu partial'ın çözdüğü şey:
      · Leaflet gelmezse  → seçici TAMAMEN ölür, koordinat girilemez.
      · Kareler gelmezse  → harita gri kalır, tıklama ve koordinat kaydı ÇALIŞIR.
    Bu yüzden CSP `img-src`'ında OpenStreetMap bilinçli olarak açık; `script-src`'ta
    hiçbir dış origin yok.
*@
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<script src="~/lib/leaflet/leaflet.js"></script>
<script nonce="@Context.Items["csp-nonce"]">
    // Haritaya tıklayarak konum seçtiren yardımcı. lat/lng inputlarını doldurur.
    function initLocationPicker(mapId, latInputId, lngInputId, clearBtnId) {
        var latInput = document.getElementById(latInputId);
        var lngInput = document.getElementById(lngInputId);

        // 🔴 Faz 12.9 — Leaflet yüklenemediyse SUS DEĞİL, SÖYLE.
        // Yerelleştirmeden sonra bu dalın tetiklenmesi çok daha zor (dosya depoda),
        // ama imkânsız değil: statik dosya servisi yanlış yapılandırılırsa ya da
        // dosya bir dağıtımda eksik kalırsa aynı duruma düşülür. Eski davranış
        // "boş kutu + log yok"tu; yöneticinin elinde koordinat girmenin BİR yolu
        // kalmalı, yoksa kayıt hiç oluşturulamaz.
        if (typeof L === 'undefined') {
            var container = document.getElementById(mapId);
            if (container) {
                container.classList.add('flex', 'items-center', 'justify-center',
                                        'bg-amber-50', 'border', 'border-amber-200', 'p-4');
                var note = document.createElement('p');
                note.className = 'text-sm text-amber-800 text-center';
                note.textContent = 'Harita bileşeni yüklenemedi. Konumu aşağıdaki ' +
                                   'enlem/boylam alanlarına elle yazabilirsiniz.';
                container.appendChild(note);
            }
            // Alanlar normalde salt-okunur/gizli tutuluyor olabilir; elle girişe aç.
            [latInput, lngInput].forEach(function (el) {
                if (el) { el.readOnly = false; el.removeAttribute('readonly'); }
            });
            return null;
        }

        var defaultCenter = [37.3708, 36.0961]; // Kadirli merkez
        var map = L.map(mapId).setView(defaultCenter, 14);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var marker = null;

        function setMarker(latlng) {
            if (marker) marker.setLatLng(latlng);
            else marker = L.marker(latlng).addTo(map);
            latInput.value = latlng.lat.toFixed(7);
            lngInput.value = latlng.lng.toFixed(7);
        }

        var lat = parseFloat((latInput.value || '').replace(',', '.'));
        var lng = parseFloat((lngInput.value || '').replace(',', '.'));
        if (!isNaN(lat) && !isNaN(lng) && (lat !== 0 || lng !== 0)) {
            var initial = L.latLng(lat, lng);
            setMarker(initial);
            map.setView(initial, 15);
        }

        map.on('click', function (e) { setMarker(e.latlng); });

        if (clearBtnId) {
            var clearBtn = document.getElementById(clearBtnId);
            if (clearBtn) clearBtn.addEventListener('click', function () {
                if (marker) { map.removeLayer(marker); marker = null; }
                latInput.value = '';
                lngInput.value = '';
            });
        }

        // Gizli sekme/collapse içinde açıldığında boyut hatasını önle
        setTimeout(function () { map.invalidateSize(); }, 250);
        return map;
    }
</script>
