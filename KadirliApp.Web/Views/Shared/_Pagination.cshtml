@model KadirliApp.Web.Models.PaginationViewModel
@*
    Ortak panel sayfalama kontrolü.

    Kullanım (liste tablosunun hemen altında, kartın İÇİNDE):
        @await Html.PartialAsync("_Pagination", PaginationViewModel.From(Model, "şikayet"))

    Bağlantılar mevcut query string'i KORUR (arama/filtre 2. sayfaya geçince kaybolmaz);
    yalnız "page" parametresi değiştirilir.
*@
@{
    // Mevcut query string'i kopyala, sayfa parametresini çıkar — kalanı her bağlantıya eklenecek.
    var preserved = Context.Request.Query
        .Where(q => !string.Equals(q.Key, PaginationViewModel.PageParameter, StringComparison.OrdinalIgnoreCase))
        .SelectMany(q => q.Value.Where(v => !string.IsNullOrEmpty(v)).Select(v => (Key: q.Key, Value: v!)))
        .ToList();

    string PageUrl(int page)
    {
        var query = string.Join("&", preserved
            .Select(p => $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(p.Value)}")
            .Append($"{PaginationViewModel.PageParameter}={page}"));

        return $"{Context.Request.Path}?{query}";
    }
}

@if (Model.TotalPages > 1)
{
    <div class="flex flex-col gap-3 px-6 py-3 border-t border-gray-200 text-sm text-gray-500 sm:flex-row sm:items-center sm:justify-between">
        <span>
            Toplam <span class="font-medium text-gray-900">@Model.TotalCount</span> @Model.ItemLabel —
            <span class="font-medium text-gray-900">@Model.FirstItemOnPage</span>-<span class="font-medium text-gray-900">@Model.LastItemOnPage</span> arası
            (sayfa @Model.CurrentPage/@Model.TotalPages)
        </span>

        <nav aria-label="Sayfalama" class="flex items-center gap-1">
            @if (Model.HasPrevious)
            {
                <a href="@PageUrl(Model.CurrentPage - 1)" rel="prev"
                   class="px-3 py-1 border border-gray-300 rounded-lg bg-white hover:bg-gray-50">Önceki</a>
            }
            else
            {
                <span class="px-3 py-1 border border-gray-200 rounded-lg bg-gray-50 text-gray-300 select-none">Önceki</span>
            }

            @* ⚠️ Döngü değişkeni "page" OLAMAZ: Razor satır içindeki @@page'i sayfa direktifi sanıp
               dosyayı Razor Page'e çevirir ve view bağlamı (Context/Model) kaybolur. *@
            @foreach (var pageNumber in Model.PageWindow())
            {
                if (pageNumber == Model.CurrentPage)
                {
                    <span aria-current="page"
                          class="px-3 py-1 border border-blue-500 rounded-lg bg-blue-50 text-blue-700 font-medium">@pageNumber</span>
                }
                else
                {
                    <a href="@PageUrl(pageNumber)"
                       class="px-3 py-1 border border-gray-300 rounded-lg bg-white hover:bg-gray-50">@pageNumber</a>
                }
            }

            @if (Model.HasNext)
            {
                <a href="@PageUrl(Model.CurrentPage + 1)" rel="next"
                   class="px-3 py-1 border border-gray-300 rounded-lg bg-white hover:bg-gray-50">Sonraki</a>
            }
            else
            {
                <span class="px-3 py-1 border border-gray-200 rounded-lg bg-gray-50 text-gray-300 select-none">Sonraki</span>
            }
        </nav>
    </div>
}
