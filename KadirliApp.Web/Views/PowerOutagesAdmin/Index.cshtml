@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.PowerOutages.DTOs.PowerOutageDto>
@{
    ViewData["Title"] = "Elektrik Kesintileri";

    string? neighborhood = ViewBag.Neighborhood;
    string? phase = ViewBag.Phase;
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
    DateTime now = ViewBag.Now ?? DateTime.UtcNow;
    int totalBeforeFilter = ViewBag.TotalBeforeFilter ?? 0;

    var hasFilter = !string.IsNullOrWhiteSpace(neighborhood) || !string.IsNullOrWhiteSpace(phase)
                    || from != null || to != null;
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Elektrik Kesintileri</h2>
        <p class="text-sm text-gray-500 mt-1">Planlı ve plansız elektrik kesintilerini yönetin.</p>
    </div>
    <div>
        <a asp-action="Create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
            <i class="fas fa-plus mr-2"></i> Yeni Ekle
        </a>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
    <form asp-action="Index" method="get" class="p-4 border-b border-gray-200 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div>
            <label for="neighborhood" class="block text-xs font-medium text-gray-600 mb-1">Mahalle / Bölge</label>
            <input id="neighborhood" name="neighborhood" type="text" value="@neighborhood" placeholder="Mahalle ara..."
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
            <label for="phase" class="block text-xs font-medium text-gray-600 mb-1">Durum</label>
            <select id="phase" name="phase" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="">Tümü</option>
                <option value="ongoing" selected="@(phase == "ongoing")">Sürüyor</option>
                <option value="planned" selected="@(phase == "planned")">Planlandı</option>
                <option value="past" selected="@(phase == "past")">Bitti</option>
            </select>
        </div>

        <div>
            <label for="from" class="block text-xs font-medium text-gray-600 mb-1">Başlangıç</label>
            <input id="from" name="from" type="date" value="@(from?.ToString("yyyy-MM-dd"))"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
            <label for="to" class="block text-xs font-medium text-gray-600 mb-1">Bitiş</label>
            <input id="to" name="to" type="date" value="@(to?.ToString("yyyy-MM-dd"))"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="flex items-end gap-3">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                <i class="fas fa-filter mr-2"></i> Filtrele
            </button>
            @if (hasFilter)
            {
                @* ⚠️ Temizleme, arama kutusu dâhil TÜM alanları sıfırlamalı — 11.7/11.8'de
                   mobilde "Filtreleri temizle" arama metnini bırakıyordu, aynı hatayı tekrarlamayalım. *@
                <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 pb-2">
                    <i class="fas fa-times mr-1"></i> Temizle
                </a>
            }
        </div>

        @if (hasFilter && Model != null)
        {
            <div class="sm:col-span-2 lg:col-span-5 text-xs text-gray-500">
                Toplam @totalBeforeFilter kaydın <span class="font-medium text-gray-800">@Model.TotalCount</span> tanesi gösteriliyor.
            </div>
        }
    </form>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th scope="col" class="px-6 py-3 font-medium">Mahalle / Bölge</th>
                    <th scope="col" class="px-6 py-3 font-medium">Durum</th>
                    <th scope="col" class="px-6 py-3 font-medium">Başlangıç</th>
                    <th scope="col" class="px-6 py-3 font-medium">Bitiş</th>
                    <th scope="col" class="px-6 py-3 font-medium">Sebep</th>
                    <th scope="col" class="px-6 py-3 text-right font-medium">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var badge = PowerOutagePhaseRules.Badge(PowerOutagePhaseRules.Phase(item.StartTime, item.EndTime, now));
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">
                                @(string.IsNullOrWhiteSpace(item.Neighborhood) ? "Şehir geneli" : item.Neighborhood)
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1 rounded px-2.5 py-0.5 text-xs font-medium @badge.Css">
                                    <i class="fas @badge.Icon"></i> @badge.Label
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                @item.StartTime.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="px-6 py-4">
                                @item.EndTime.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="px-6 py-4 truncate max-w-xs">
                                @item.Reason
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900 mr-3" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" data-confirm="@(item.Neighborhood ?? "Şehir geneli") kesinti kaydını silmek istediğinize emin misiniz?">
                                    <button type="submit" class="text-red-600 hover:text-red-900" title="Sil">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-inbox text-4xl text-gray-300 mb-3"></i>
                                <p>@(hasFilter ? "Bu filtreye uyan kesinti yok." : "Kayıt bulunamadı.")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", PaginationViewModel.From(Model, "kesinti"))
</div>
