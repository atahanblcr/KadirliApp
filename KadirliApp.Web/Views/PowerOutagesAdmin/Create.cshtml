@model KadirliApp.Application.Features.PowerOutages.DTOs.CreatePowerOutageDto
@{
    ViewData["Title"] = "Yeni Kesinti Ekle";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-semibold text-gray-800">Yeni Kesinti Ekle</h2>
            <p class="text-sm text-gray-500 mt-1">Sisteme yeni bir elektrik kesintisi kaydı ekleyin.</p>
        </div>
        <div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 font-medium">
                <i class="fas fa-arrow-left mr-1"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-lg overflow-hidden">
        <form asp-action="Create" method="post" id="outage-form" class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <partial name="_OutageForm" model="Model" />

                <div>
                    <label asp-for="StartTime" class="block text-sm font-medium text-gray-700 mb-2">Başlangıç Zamanı <span class="text-red-500">*</span></label>
                    <input asp-for="StartTime" type="datetime-local" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" required />
                    <span asp-validation-for="StartTime" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="EndTime" class="block text-sm font-medium text-gray-700 mb-2">Bitiş Zamanı <span class="text-red-500">*</span></label>
                    <input asp-for="EndTime" type="datetime-local" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" required />
                    <span asp-validation-for="EndTime" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Reason" class="block text-sm font-medium text-gray-700 mb-2">Kesinti Sebebi</label>
                    <textarea asp-for="Reason" rows="3" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" placeholder="Kesintinin nedenini giriniz..."></textarea>
                    <span asp-validation-for="Reason" class="text-sm text-red-600 mt-1 block"></span>
                </div>

            </div>

            <div class="mt-8 pt-5 border-t border-gray-200 flex justify-end gap-3">
                <a asp-action="Index" class="px-6 py-2.5 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm">
                    İptal
                </a>
                <button type="submit" class="px-6 py-2.5 border border-transparent rounded-lg shadow-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <partial name="_OutageFormScripts" />
}
