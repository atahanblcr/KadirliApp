@using KadirliApp.Web.Common
@inject IPanelMenuProvider MenuProvider
@model KadirliApp.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // ⚠️ Faz 11.15b dersi: moderatöre, tıklayınca "Yetkiniz yok" diyecek bir bağlantı
    // ÇİZİLMEZ. Onay kuyruğu satırları da menüyle aynı süzgeçten geçiyor.
    var visibleControllers = (await MenuProvider.VisibleItemsAsync(User))
        .Select(i => i.Controller)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var pendingQueue = Model.PendingQueue.Where(q => visibleControllers.Contains(q.Controller)).ToList();
}

<div class="mb-4 flex justify-between items-center">
    <h2 class="text-2xl font-bold text-gray-800">Sistem Durumu</h2>
    @* Faz 11.15b: Dashboard artık moderatöre de açık, ama örnek veri basma aksiyonu
       yalnız admin'e. Buton herkese çizilseydi moderatör tıklar ve "Yetkiniz yok"
       sayfasına düşerdi — panelde işlevsiz buton bırakmıyoruz. *@
    @if (User.IsInRole("admin") || User.IsInRole("super_admin"))
    {
        <a href="/Dashboard/Seed" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg shadow transition-colors">
            <i class="fas fa-database mr-2"></i> Paneli Test Verileriyle Doldur
        </a>
    }
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <!-- Stat Cards -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <div class="flex items-center">
            <div class="p-3 rounded-full bg-blue-100 text-blue-500">
                <i class="fas fa-users text-2xl"></i>
            </div>
            <div class="ml-4">
                <p class="text-sm text-gray-500 font-medium">Toplam Kullanıcı</p>
                <p class="text-2xl text-gray-800 font-semibold">@Model.TotalUsers.ToString("N0")</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <div class="flex items-center">
            <div class="p-3 rounded-full bg-green-100 text-green-500">
                <i class="fas fa-bullhorn text-2xl"></i>
            </div>
            <div class="ml-4">
                @* 11.15c: "aktif" artık vatandaşın gördüğüyle aynı tanım (onaylı VE süresi geçmemiş). *@
                <p class="text-sm text-gray-500 font-medium" title="Onaylı ve süresi dolmamış — mobilde görünen ilan sayısı">Yayındaki İlanlar</p>
                <p class="text-2xl text-gray-800 font-semibold">@Model.ActiveAds.ToString("N0")</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <div class="flex items-center">
            <div class="p-3 rounded-full bg-yellow-100 text-yellow-500">
                <i class="fas fa-exclamation-triangle text-2xl"></i>
            </div>
            <div class="ml-4">
                <p class="text-sm text-gray-500 font-medium">Bekleyen Onaylar</p>
                <p class="text-2xl text-gray-800 font-semibold">@Model.PendingApprovals.ToString("N0")</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <div class="flex items-center">
            <div class="p-3 rounded-full bg-purple-100 text-purple-500">
                <i class="fas fa-bell text-2xl"></i>
            </div>
            <div class="ml-4">
                <p class="text-sm text-gray-500 font-medium" title="Yayında ve görünürlük süresi dolmamış duyurular">Yayındaki Duyurular</p>
                <p class="text-2xl text-gray-800 font-semibold">@Model.TotalAnnouncements.ToString("N0")</p>
            </div>
        </div>
    </div>
</div>

@*
    Faz 11.15c — ONAY KUYRUĞU.
    "Bekleyen Onaylar" kartı 10.10'dan beri tıklanamayan tek bir sayıydı; oysa
    GetDashboardStatsQueryHandler kırılımı (PendingBreakdown) zaten hesaplıyor ve
    sonuç hiçbir yerde okunmuyordu. Artık her satır ilgili modülün bekleyen
    filtresine gidiyor — yöneticinin işe nereden başlayacağı tek bakışta belli.
*@
@if (pendingQueue.Count > 0)
{
    <div class="bg-white rounded-lg border border-amber-200 shadow-sm p-4 mb-6">
        <p class="text-xs text-gray-400 uppercase font-medium mb-3">
            <i class="fas fa-inbox mr-1" aria-hidden="true"></i>Onay Kuyruğu
        </p>
        <div class="flex flex-wrap gap-2">
            @foreach (var q in pendingQueue)
            {
                <a asp-controller="@q.Controller" asp-action="Index" asp-route-status="@q.StatusValue"
                   class="inline-flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900 hover:bg-amber-100 transition-colors">
                    <i class="fas @q.Icon" aria-hidden="true"></i>
                    <span class="font-medium">@q.Label</span>
                    <span class="rounded-full bg-amber-600 px-2 py-0.5 text-xs font-semibold text-white">@q.Count.ToString("N0")</span>
                </a>
            }
        </div>
    </div>
}

@*
    Faz 12.1 — HATA ROZETİ (yalnız admin).
    Model.OpenErrorCount null ise kullanıcı bu ekranı göremez (moderatör) ve kart hiç
    çizilmez. Sıfır ile null farklı: sıfırda "hata yok" yazar — sessizlik ile iyi haberi
    ayırt edemeyen bir pano, gözlem panosu değildir.
*@
@if (Model.OpenErrorCount is { } openErrors)
{
    <a asp-controller="ErrorLogsAdmin" asp-action="Index" asp-route-resolved="false"
       class="mb-6 flex items-center justify-between rounded-lg border @(openErrors > 0 ? "border-red-200 bg-red-50 hover:bg-red-100" : "border-green-200 bg-green-50 hover:bg-green-100") p-4 transition-colors">
        <div class="flex items-center gap-3">
            <i class="fas @(openErrors > 0 ? "fa-triangle-exclamation text-red-600" : "fa-circle-check text-green-600") text-xl" aria-hidden="true"></i>
            <div>
                <p class="text-sm font-medium @(openErrors > 0 ? "text-red-900" : "text-green-900")">
                    @(openErrors > 0 ? $"Son 24 saatte {openErrors:N0} açık hata kaydı" : "Son 24 saatte açık hata kaydı yok")
                </p>
                <p class="text-xs @(openErrors > 0 ? "text-red-700" : "text-green-700")">
                    Sunucu, panel ve mobil uygulamada oluşan hatalar
                </p>
            </div>
        </div>
        <i class="fas fa-chevron-right text-gray-400" aria-hidden="true"></i>
    </a>
}

@*
    Faz 12.2 — ŞÜPHELİ GİRİŞ ROZETİ (yalnız admin), hata rozetiyle aynı kural.
    Sıfır ile null yine farklı: sıfırda "şüpheli giriş yok" yazar. Kartın sessiz kalması
    "bir şey olmadı" değil "bakmıyorum" demek olurdu.
*@
@if (Model.SuspiciousLoginCount is { } suspiciousLogins)
{
    <a asp-controller="LoginAttemptsAdmin" asp-action="Index" asp-route-suspicious="true"
       class="mb-6 flex items-center justify-between rounded-lg border @(suspiciousLogins > 0 ? "border-red-200 bg-red-50 hover:bg-red-100" : "border-green-200 bg-green-50 hover:bg-green-100") p-4 transition-colors">
        <div class="flex items-center gap-3">
            <i class="fas @(suspiciousLogins > 0 ? "fa-user-lock text-red-600" : "fa-shield-halved text-green-600") text-xl" aria-hidden="true"></i>
            <div>
                <p class="text-sm font-medium @(suspiciousLogins > 0 ? "text-red-900" : "text-green-900")">
                    @(suspiciousLogins > 0 ? $"Son 24 saatte {suspiciousLogins:N0} şüpheli giriş denemesi" : "Son 24 saatte şüpheli giriş denemesi yok")
                </p>
                <p class="text-xs @(suspiciousLogins > 0 ? "text-red-700" : "text-green-700")">
                    Panel ve mobil (OTP) girişlerinde otomatik kurallarla işaretlenenler
                </p>
            </div>
        </div>
        <i class="fas fa-chevron-right text-gray-400" aria-hidden="true"></i>
    </a>
}

@*
    Faz 12.2b — SON GÖNDERİM SATIRI (yalnız admin).
    Diğer iki rozetten farkı: burada "sıfır" diye bir hâl yok. Hiç gönderim yapılmamışsa
    gösterilecek bir teslim de yoktur ve kart çizilmez — "0 gönderim" satırı bir haber değil,
    gürültü olurdu.
*@
@if (Model.LastPushCampaign is { } lastPush)
{
    var pushStatus = PanelDisplay.PushStatus(lastPush.Status);
    var pushFailed = lastPush.FailedCount > 0;
    <a asp-controller="PushCampaignsAdmin" asp-action="Details" asp-route-id="@lastPush.Id"
       class="mb-6 flex items-center justify-between rounded-lg border @(pushFailed ? "border-amber-200 bg-amber-50 hover:bg-amber-100" : "border-gray-200 bg-gray-50 hover:bg-gray-100") p-4 transition-colors">
        <div class="flex items-center gap-3">
            <i class="fas fa-paper-plane @(pushFailed ? "text-amber-600" : "text-gray-500") text-xl" aria-hidden="true"></i>
            <div>
                <p class="text-sm font-medium @(pushFailed ? "text-amber-900" : "text-gray-900")">
                    Son gönderim: @lastPush.SentCount / @lastPush.RecipientCount teslim
                    @if (pushFailed)
                    {
                        <span>· @lastPush.FailedCount başarısız</span>
                    }
                </p>
                <p class="text-xs @(pushFailed ? "text-amber-700" : "text-gray-600")">
                    @lastPush.Title — @pushStatus.Label
                </p>
            </div>
        </div>
        <i class="fas fa-chevron-right text-gray-400" aria-hidden="true"></i>
    </a>
}

<!-- Faz 10.10-A: Etkileşim satırı — üç 7-günlük nabız + duyuru erişim toplamı (mobil yayınla dolmaya başlar) -->
<div class="bg-white rounded-lg border border-gray-200 shadow-sm p-4 mb-6">
    <p class="text-xs text-gray-400 uppercase font-medium mb-3"><i class="fas fa-chart-line mr-1"></i>Etkileşim</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div>
            <p class="text-xl text-gray-800 font-semibold">@Model.NewUsersLast7Days.ToString("N0")</p>
            <p class="text-xs text-gray-500">Yeni Kayıt <span class="text-gray-400">(7 gün)</span></p>
        </div>
        <div>
            <p class="text-xl text-gray-800 font-semibold">@Model.TaxiCallsLast7Days.ToString("N0")</p>
            <p class="text-xs text-gray-500">Taksi Çağrısı <span class="text-gray-400">(7 gün)</span></p>
        </div>
        <div>
            <p class="text-xl text-gray-800 font-semibold">@Model.NewAdsLast7Days.ToString("N0")</p>
            <p class="text-xs text-gray-500">Yeni İlan <span class="text-gray-400">(7 gün)</span></p>
        </div>
        <div>
            <p class="text-xl text-gray-800 font-semibold">@Model.TotalAnnouncementViews.ToString("N0")</p>
            <p class="text-xs text-gray-500">Duyuru Görüntüleme <span class="text-gray-400">(toplam)</span></p>
        </div>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
    <div class="p-6 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-800">Son Aktiviteler</h3>
    </div>
    <div class="p-6">
        @if (Model.RecentActivities.Count == 0)
        {
            <p class="text-gray-500">Henüz aktivite bulunmuyor. "Paneli Test Verileriyle Doldur" butonuyla örnek veri ekleyebilirsiniz.</p>
        }
        else
        {
            <ul class="divide-y divide-gray-100">
                @foreach (var activity in Model.RecentActivities)
                {
                    <li class="py-3 flex items-center gap-4">
                        <span class="p-2 rounded-full bg-gray-100 text-gray-500 w-10 h-10 flex items-center justify-center shrink-0">
                            <i class="fas @activity.Icon"></i>
                        </span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-800 truncate">@activity.Title</p>
                            <p class="text-xs text-gray-500">@activity.Type</p>
                        </div>
                        <span class="text-xs text-gray-400 whitespace-nowrap">@activity.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
