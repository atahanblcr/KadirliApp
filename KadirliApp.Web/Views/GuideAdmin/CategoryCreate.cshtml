@model KadirliApp.Application.Features.Guide.Commands.CreateGuideCategoryCommand
@{
    ViewData["Title"] = "Yeni Rehber Kategorisi";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Yeni Rehber Kategorisi</h2>
            <p class="text-sm text-gray-500 mt-1">Rehber kayıtlarının gruplanacağı yeni bir kategori ekleyin (örn: Sağlık, Acil Numaralar).</p>
        </div>
        <div>
            <a asp-action="Categories" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-300 bg-white shadow-sm">
                <i class="fas fa-arrow-left mr-2"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6 sm:p-8">
        <form asp-action="CategoryCreate" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="col-span-1 md:col-span-2">
                    <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">Kategori Adı <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Sağlık Kuruluşları" required />
                    <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                    <p class="text-xs text-gray-400 mt-1">URL bağlantısı (slug) otomatik oluşturulur.</p>
                </div>

                <!-- Icon -->
                <div>
                    <label asp-for="Icon" class="block text-sm font-semibold text-gray-700 mb-2">İkon (FontAwesome)</label>
                    <input asp-for="Icon" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="fas fa-hospital" />
                    <p class="text-xs text-gray-400 mt-1">Örn: fas fa-hospital, fas fa-landmark, fas fa-phone</p>
                </div>

                <!-- Color -->
                <div>
                    <label asp-for="Color" class="block text-sm font-semibold text-gray-700 mb-2">Renk</label>
                    <input asp-for="Color" type="color" value="#6366f1" class="w-full h-[50px] px-2 py-1 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 transition-colors shadow-sm cursor-pointer" />
                </div>

                <!-- Display Order -->
                <div>
                    <label asp-for="DisplayOrder" class="block text-sm font-semibold text-gray-700 mb-2">Gösterim Sırası</label>
                    <input asp-for="DisplayOrder" type="number" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" value="0" />
                </div>
            </div>

            <div class="pt-6 border-t border-gray-200 mt-6 flex justify-end">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-lg shadow-md transition-all flex items-center">
                    <i class="fas fa-save mr-2"></i> Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
