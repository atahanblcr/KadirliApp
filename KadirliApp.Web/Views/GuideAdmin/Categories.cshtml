@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.Guide.Dtos.GuideCategoryResponseDto>
@{
    ViewData["Title"] = "Rehber Kategorileri";
    var counts = ViewBag.ItemCounts as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Rehber Kategorileri</h2>
        <p class="text-sm text-gray-500 mt-1">Şehir rehberindeki kayıtların gruplandığı kategoriler (Sağlık, Resmi Kurumlar, Acil Numaralar…).</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="Index" class="text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
            <i class="fas fa-address-book mr-2"></i> Rehber Kayıtları
        </a>
        <a asp-action="CategoryCreate" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow">
            <i class="fas fa-plus mr-2"></i> Yeni Kategori
        </a>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th scope="col" class="px-6 py-3 font-medium">Kategori</th>
                    <th scope="col" class="px-6 py-3 font-medium">Kayıt Sayısı</th>
                    <th scope="col" class="px-6 py-3 font-medium">Sıra</th>
                    <th scope="col" class="px-6 py-3 text-right font-medium">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var itemCount = counts.TryGetValue(item.Id, out var c) ? c : 0;
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">
                                <div class="flex items-center gap-3">
                                    <span class="w-9 h-9 flex items-center justify-center rounded-lg text-white"
                                          style="background-color: @(item.Color ?? "#6366f1");">
                                        <i class="@(string.IsNullOrEmpty(item.Icon) ? "fas fa-folder" : item.Icon)"></i>
                                    </span>
                                    <div>
                                        <div>@item.Name</div>
                                        <div class="text-xs text-gray-400">@item.Slug</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if (itemCount > 0)
                                {
                                    <a asp-action="Index" asp-route-CategoryId="@item.Id" class="text-indigo-600 hover:underline">@itemCount kayıt</a>
                                }
                                else
                                {
                                    <span class="text-gray-300">0 kayıt</span>
                                }
                            </td>
                            <td class="px-6 py-4">@item.DisplayOrder</td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a asp-action="CategoryEdit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="CategoryDelete" method="post" class="inline" data-confirm="Kategoriyi silmek istediğinize emin misiniz?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="text-red-600 hover:text-red-900" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-tags text-4xl text-gray-300 mb-3"></i>
                                <p>Henüz kategori yok.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
