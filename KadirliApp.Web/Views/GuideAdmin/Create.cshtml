@model KadirliApp.Application.Features.Guide.Commands.CreateGuideItemCommand
@{
    ViewData["Title"] = "Yeni Rehber Kaydı";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Yeni Rehber Kaydı</h2>
            <p class="text-sm text-gray-500 mt-1">Hastane, belediye, itfaiye gibi önemli bir yerin iletişim bilgilerini ekleyin.</p>
        </div>
        <div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-300 bg-white shadow-sm">
                <i class="fas fa-arrow-left mr-2"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div>
                    <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">Yer Adı <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Kadirli Devlet Hastanesi" required />
                    <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Category -->
                <div>
                    <label asp-for="CategoryId" class="block text-sm font-semibold text-gray-700 mb-2">Kategori <span class="text-red-500">*</span></label>
                    <select asp-for="CategoryId" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" required>
                        <option value="">-- Kategori Seçiniz --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                    <p class="text-xs text-gray-400 mt-1">Uygun kategori yoksa <a asp-action="CategoryCreate" class="text-indigo-600 hover:underline" target="_blank">yeni kategori ekleyin</a>.</p>
                </div>

                <!-- Phone -->
                <div>
                    <label asp-for="Phone" class="block text-sm font-semibold text-gray-700 mb-2">Telefon</label>
                    <input asp-for="Phone" type="tel" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: 0328 718 10 26" />
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-2">E-posta</label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="ornek@kurum.gov.tr" />
                </div>

                <!-- Website -->
                <div>
                    <label asp-for="WebsiteUrl" class="block text-sm font-semibold text-gray-700 mb-2">Web Sitesi</label>
                    <input asp-for="WebsiteUrl" type="url" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="https://..." />
                </div>

                <!-- Working hours -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Çalışma Saatleri</label>
                    <div class="flex items-center gap-2">
                        <input type="time" id="openTime" class="flex-1 px-3 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 shadow-sm" />
                        <span class="text-gray-400">—</span>
                        <input type="time" id="closeTime" class="flex-1 px-3 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 shadow-sm" />
                    </div>
                    <label class="flex items-center gap-2 mt-2 text-xs text-gray-600">
                        <input type="checkbox" id="alwaysOpen" class="h-4 w-4 rounded border-gray-300 text-indigo-600" data-always-open>
                        <span>7/24 hizmet (örn: acil servis, itfaiye)</span>
                    </label>
                    <input type="hidden" asp-for="WorkingHours" id="workingHours" />
                </div>

                <!-- Address -->
                <div class="col-span-1 md:col-span-2">
                    <label asp-for="Address" class="block text-sm font-semibold text-gray-700 mb-2">Adres</label>
                    <input asp-for="Address" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" />
                </div>

                <!-- Location -->
                <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700">Konum <span class="text-gray-400 font-normal">(opsiyonel)</span></label>
                            <p class="text-xs text-gray-500 mt-1">Konum seçerseniz mobil uygulamada "Konuma Git" butonu görünür.</p>
                        </div>
                        <button type="button" id="clearLocationBtn" class="text-sm text-red-600 hover:underline"><i class="fas fa-times mr-1"></i>Temizle</button>
                    </div>
                    <div id="locationMap" class="w-full rounded-lg border border-gray-300" style="height: 280px;"></div>
                    <div class="grid grid-cols-2 gap-4 mt-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-500">Enlem</label>
                            <input asp-for="Latitude" id="latInput" type="text" readonly class="mt-1 bg-gray-50 w-full text-sm border-gray-300 rounded-md py-2 px-3 border text-gray-500" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-500">Boylam</label>
                            <input asp-for="Longitude" id="lngInput" type="text" readonly class="mt-1 bg-gray-50 w-full text-sm border-gray-300 rounded-md py-2 px-3 border text-gray-500" />
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="col-span-1 md:col-span-2">
                    <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">Açıklama</label>
                    <textarea asp-for="Description" rows="3" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Kısa bilgi (opsiyonel)..."></textarea>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-200 mt-6 flex justify-end">
                <button type="submit" data-compose-hours class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-lg shadow-md transition-all flex items-center">
                    <i class="fas fa-save mr-2"></i> Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<partial name="_LocationPickerScripts" />
<script nonce="@Context.Items["csp-nonce"]">
    initLocationPicker('locationMap', 'latInput', 'lngInput', 'clearLocationBtn');

    (function initHours() {
        var raw = document.getElementById('workingHours').value || '';
        if (/7\s*\/\s*24|24 saat/i.test(raw)) {
            document.getElementById('alwaysOpen').checked = true;
            toggleAlwaysOpen();
            return;
        }
        var m = raw.match(/(\d{1,2})[:.](\d{2})\s*[-–—]\s*(\d{1,2})[:.](\d{2})/);
        if (m) {
            document.getElementById('openTime').value = m[1].padStart(2, '0') + ':' + m[2];
            document.getElementById('closeTime').value = m[3].padStart(2, '0') + ':' + m[4];
        }
    })();

    function toggleAlwaysOpen() {
        var always = document.getElementById('alwaysOpen').checked;
        document.getElementById('openTime').disabled = always;
        document.getElementById('closeTime').disabled = always;
    }

    function composeWorkingHours() {
        if (document.getElementById('alwaysOpen').checked) {
            document.getElementById('workingHours').value = '7/24 Açık';
        } else {
            var open = document.getElementById('openTime').value;
            var close = document.getElementById('closeTime').value;
            document.getElementById('workingHours').value = (open && close) ? (open + ' - ' + close) : '';
        }
    }

    // ————————————————————————————————————————————————————————————
    // Faz 12.9 — bağlamalar satır içi on*= özniteliğinden BURAYA taşındı.
    // CSP `script-src 'self' 'nonce-…'` ile kurulu ve `unsafe-inline` YOK;
    // nonce yalnız script BLOKLARINI kapsar, öznitelikleri kapsamaz.
    // ————————————————————————————————————————————————————————————

    document.querySelector('[data-always-open]')?.addEventListener('change', toggleAlwaysOpen);
    document.querySelector('[data-compose-hours]')?.addEventListener('click', composeWorkingHours);
</script>
