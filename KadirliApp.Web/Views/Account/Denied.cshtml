@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="flex flex-col items-center justify-center py-24 text-center">
    <i class="fas fa-lock text-5xl text-gray-300 mb-4"></i>
    <h2 class="text-2xl font-semibold text-gray-800 mb-2">Bu sayfaya erişim yetkiniz yok</h2>
    <p class="text-sm text-gray-500 max-w-md">
        Hesabınızın rolü bu bölümü görüntülemeye izin vermiyor. Yetki gerektiğini düşünüyorsanız bir yöneticiyle iletişime geçin.
    </p>
    <div class="mt-6 flex gap-3">
        <a asp-controller="Account" asp-action="ChangePassword" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50">Şifremi Değiştir</a>
        <a asp-controller="Account" asp-action="Logout" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg shadow hover:bg-indigo-700">Çıkış Yap</a>
    </div>
</div>
