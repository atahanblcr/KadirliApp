@using KadirliApp.Application.Common.Security
@{
    ViewData["Title"] = "Şifremi Değiştir";
    // Faz 11.18: filtre kullanıcıyı buraya ZORLADIYSA ekran farklı davranır —
    // "Vazgeç" bağlantısı çizilmez (gidebileceği bir yer yok) ve neden burada olduğu yazılır.
    var forced = ViewBag.Forced is true;
}

<div class="max-w-lg mx-auto">
    <div class="mb-6">
        <h2 class="text-2xl font-semibold text-gray-800">Şifremi Değiştir</h2>
        @* 🔑 Politika metni PanelPasswordPolicy'den geliyor: kural sıkılaşınca ekran
           kendiliğinden doğruyu yazar. Elle yazılsaydı "en az 6 karakter" cümlesi
           kuraldan bağımsız yaşamaya devam ederdi (11.18 öncesi tam olarak öyleydi). *@
        <p class="text-sm text-gray-500 mt-1">Panel giriş şifrenizi güncelleyin. @PanelPasswordPolicy.Description</p>
    </div>

    @if (forced)
    {
        <div class="p-4 mb-4 text-sm text-amber-900 rounded-lg bg-amber-50 border border-amber-200 shadow-sm" role="alert">
            <p class="font-medium"><i class="fas fa-shield-halved mr-1"></i>Devam etmeden önce şifrenizi değiştirmelisiniz.</p>
            <p class="mt-1">
                Hesabınızın şifresi size başkası tarafından verildi (kurulum varsayılanı ya da
                yönetici sıfırlaması). Kendi şifrenizi belirleyene kadar paneldeki diğer sayfalar açılmaz.
            </p>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 shadow-sm" role="alert">@ViewBag.Error</div>
    }

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <form asp-action="ChangePassword" method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Mevcut Şifre</label>
                <input type="password" name="currentPassword" required autocomplete="current-password"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Yeni Şifre</label>
                <input type="password" name="newPassword" required minlength="@PanelPasswordPolicy.MinLength" autocomplete="new-password"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <p class="text-xs text-gray-500 mt-1">@PanelPasswordPolicy.Description</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Yeni Şifre (Tekrar)</label>
                <input type="password" name="newPasswordConfirm" required minlength="@PanelPasswordPolicy.MinLength" autocomplete="new-password"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                @if (!forced)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="text-sm text-gray-500 hover:text-gray-700">Vazgeç</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Logout" class="text-sm text-gray-500 hover:text-gray-700">Çıkış yap</a>
                }
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
                    <i class="fas fa-key mr-1"></i>Şifreyi Değiştir
                </button>
            </div>
        </form>
    </div>
</div>
