@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - KadirliApp Admin Paneli</title>
    @*
        Faz 12.9 — giriş ekranı `Layout = null` olduğu için _Layout'un <head>'ini
        PAYLAŞMIYOR: 12.9 öncesinde Tailwind'in İKİNCİ bir CDN kopyasını ve Google
        Fonts'tan Inter'i kendi başına çekiyordu. Yani düzeltme yalnız _Layout'ta
        yapılsaydı panelin İLK açılan ekranı hâlâ dış origine bağlı kalırdı —
        üstelik oturum açılmadan görülen tek sayfa burası.

        Yazı tipi artık yerel (wwwroot/lib/inter, latin + latin-ext; Türkçe'nin
        ğ/ş/İ/ı harfleri latin-ext'te) ve `<style>` bloğu yerine `font-inter`
        yardımcı sınıfıyla uygulanıyor — blok kalsaydı CSP'nin style-src'ında
        istisna gerekirdi.
    *@
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/inter/inter.css" />
</head>
<body class="font-inter bg-gray-50 flex items-center justify-center min-h-screen">

    <div class="max-w-md w-full bg-white rounded-xl shadow-lg p-8">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-gray-900">KadirliApp</h2>
            <p class="text-sm text-gray-500 mt-2">Yönetim Paneline Hoş Geldiniz</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 text-sm text-center font-medium">
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Account/Login">
            @Html.AntiForgeryToken() @* düz HTML form — tag helper token basmaz, global antiforgery için şart *@
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            
            <div class="mb-5">
                <label class="block text-sm font-medium text-gray-700 mb-2">Kullanıcı Adı</label>
                <input type="text" name="username" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-colors" placeholder="admin" required />
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Şifre</label>
                <input type="password" name="password" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-colors" placeholder="••••••••" required />
            </div>

            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200">
                Sisteme Giriş Yap
            </button>
        </form>

        @*
            🔒 Faz 11.15c: bu satır ortam koşulu OLMADAN basılıyordu — yani üretimde de
            varsayılan yönetici parolasını herkese gösteriyordu. Artık yalnız Development'ta
            görünür. (İlk açılışta parola değişimini zorlama maddesi 11.16'da.)
        *@
        @if (Env.IsDevelopment())
        {
            <div class="mt-6 text-center text-xs text-gray-400">
                <p>Varsayılan Yönetici: <b>admin / Admin123!</b></p>
                <p class="mt-1 text-gray-300">(yalnız geliştirme ortamında görünür)</p>
            </div>
        }
    </div>

</body>
</html>
