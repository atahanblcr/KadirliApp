@model KadirliApp.Application.Features.Transport.Commands.UpdateIntercityRouteCommand
@{
    ViewData["Title"] = "Hat Düzenle";
    var schedules = ViewBag.Schedules as List<KadirliApp.Application.Features.Transport.Dtos.IntercityRouteResponseDto.ScheduleDto>
                    ?? new List<KadirliApp.Application.Features.Transport.Dtos.IntercityRouteResponseDto.ScheduleDto>();
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">@Model.Destination</h2>
            <p class="text-sm text-gray-500 mt-1">Hat bilgileri ve kalkış saatleri.</p>
        </div>
        <a asp-action="Intercity" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium transition-colors">
            <i class="fas fa-arrow-left mr-1"></i> Listeye Dön
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <form asp-action="IntercityEdit" method="post" class="p-8">
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    <label asp-for="Destination" class="block text-sm font-semibold text-gray-700 mb-2">Varış Yeri</label>
                    <input asp-for="Destination" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm outline-none" required />
                    <span asp-validation-for="Destination" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Company" class="block text-sm font-semibold text-gray-700 mb-2">Firma</label>
                    <input asp-for="Company" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm outline-none" />
                    <span asp-validation-for="Company" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-2">Ücret (₺)</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm outline-none" />
                    <span asp-validation-for="Price" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="DurationMinutes" class="block text-sm font-semibold text-gray-700 mb-2">Yolculuk Süresi (Dakika)</label>
                    <input asp-for="DurationMinutes" type="number" min="1" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm outline-none" />
                    <span asp-validation-for="DurationMinutes" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center mt-8">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="sr-only peer">
                        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                        <span class="ml-3 text-sm font-medium text-gray-700">Aktif olarak işaretle</span>
                    </label>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5">
                    <i class="fas fa-save mr-2"></i> Kaydet
                </button>
            </div>
        </form>
    </div>

    @* Kalkış saatleri ayrı bir form: hat bilgisini kaydetmeden saat eklenebilmeli.
       Mobil "Sıradaki 14:00 · 1 sa 16 dk sonra" satırını bu listeden hesaplıyor. *@
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden mt-8">
        <div class="px-8 py-5 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-800"><i class="fas fa-clock mr-2 text-indigo-500"></i> Kalkış Saatleri</h3>
            <p class="text-sm text-gray-500 mt-1">Mobil uygulamada "sıradaki kalkış" bu listeden hesaplanır.</p>
        </div>

        <div class="p-8">
            <form asp-action="AddSchedule" method="post" class="flex flex-col sm:flex-row gap-3 mb-6">
                <input type="hidden" name="routeId" value="@Model.Id" />
                <input type="time" name="departureTime" required
                       class="px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm outline-none"
                       aria-label="Yeni kalkış saati" />
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-xl shadow-md transition-all">
                    <i class="fas fa-plus mr-2"></i> Saat Ekle
                </button>
            </form>

            @if (schedules.Any())
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var s in schedules)
                    {
                        <form asp-action="DeleteSchedule" asp-route-id="@s.Id" asp-route-routeId="@Model.Id" method="post"
                              class="inline-flex" data-confirm="@($"{s.DepartureTime} kalkışını silmek istediğinize emin misiniz?")">
                            <button type="submit"
                                    class="group inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors @(s.IsActive ? "border-gray-300 bg-gray-50 text-gray-800 hover:border-red-300 hover:bg-red-50" : "border-amber-300 bg-amber-50 text-amber-800")"
                                    title="Sil">
                                @s.DepartureTime
                                @if (!s.IsActive)
                                {
                                    <span class="text-xs">(pasif — mobilde görünmez)</span>
                                }
                                <i class="fas fa-times text-gray-400 group-hover:text-red-600"></i>
                            </button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                    <i class="fas fa-triangle-exclamation mr-2"></i>
                    Bu hatta hiç kalkış saati yok — mobil uygulamada hattın altında sefer görünmez.
                </div>
            }
        </div>
    </div>

    <div class="mt-8 flex justify-end">
        <form asp-action="IntercityDelete" asp-route-id="@Model.Id" method="post"
              data-confirm="@($"\"{Model.Destination}\" hattını ve tüm kalkış saatlerini silmek istediğinize emin misiniz?")">
            <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-800">
                <i class="fas fa-trash-alt mr-1"></i> Bu hattı sil
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
