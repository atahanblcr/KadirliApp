@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.Campaigns.Dtos.CampaignResponseDto>
@{
    ViewData["Title"] = "Kampanya Yönetimi";

    // Faz 11.18 — toplu işlem çubuğu ve satır kutuları tek yerden kurulur.
    var bulkController = "CampaignsAdmin";
    var bulkToolbar = KadirliApp.Web.Models.BulkToolbarViewModel.Moderation("CampaignsAdmin", "kampanya");

    // Faz 11.18 — tıklanabilir sütun başlıkları etkin sıralamayı buradan okur.
    var currentSort = Context.Request.Query["sort"].ToString();
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Kampanya Yönetimi</h2>
        <p class="text-sm text-gray-500 mt-1">İşletme kampanyalarını görüntüleyin, onaylayın ve yönetin.</p>
    </div>
    <div class="flex items-center gap-2">
        <partial name="_ExportCsvButton" />
        <a asp-action="Create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow">
            <i class="fas fa-plus mr-2"></i> Yeni Ekle
        </a>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm" data-bulk-scope>
    <div class="p-4 border-b border-gray-200">
        <form action="" method="get" class="relative w-full md:w-64">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-search text-gray-400"></i>
            </div>
            <input type="text" name="Search" placeholder="Başlık ile ara..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" value="@Context.Request.Query["Search"]">
        </form>
    </div>

    @* Faz 11.18: toplu işlem — satır seçimi + toplu eylem. *@
    <partial name="_BulkToolbar" model="bulkToolbar" />
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <partial name="_BulkSelectAll" />
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Kampanya", "title_asc", "title_desc", currentSort)' />
                    <th scope="col" class="px-6 py-3 font-medium">İşletme</th>
                    <th scope="col" class="px-6 py-3 font-medium">İndirim</th>
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Tarih Aralığı", "end_asc", "end_desc", currentSort)' />
                    <th scope="col" class="px-6 py-3 font-medium" title="Kodu kaç farklı kullanıcı görüntüledi">Kod Gör.</th>
                    <th scope="col" class="px-6 py-3 font-medium">Durum</th>
                    <th scope="col" class="px-6 py-3 text-right font-medium">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <partial name="_BulkRowCheckbox" model="KadirliApp.Web.Models.BulkRowViewModel.For(bulkController, item.Id)" />
                            <td class="px-6 py-4 font-medium text-gray-900">@item.Title</td>
                            <td class="px-6 py-4">@(item.BusinessName ?? "—")</td>
                            <td class="px-6 py-4">
                                @if (item.DiscountPercentage.HasValue)
                                {
                                    <span class="text-green-600 font-semibold">%@item.DiscountPercentage.Value.ToString("0.#")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span>@item.StartDate.ToString("dd.MM.yyyy")</span>
                                    <span class="text-xs text-gray-400">→ @item.EndDate.ToString("dd.MM.yyyy")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @* Faz 10.10-A: kullanıcı başına tek kayıt tutulduğundan "kaç farklı kullanıcı" demektir *@
                                <span class="font-medium text-gray-900">@item.CodeViewCount.ToString("N0")</span>
                            </td>
                            <td class="px-6 py-4">
                                <partial name="_StatusBadge" model="PanelDisplay.Status(item.Status)" />
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 items-center">
                                    @if (item.Status != "approved")
                                    {
                                        <form asp-action="Approve" method="post" class="inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="text-green-600 hover:text-green-900" title="Onayla">
                                                <i class="fas fa-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    @*
                                        Faz 12.10: red sebebi artık soruluyor. Komut sebebi 11.15b'den beri
                                        kabul ediyordu ama panel hiç göndermiyordu — işletme sahibi kampanyasının
                                        NEDEN reddedildiğini hiçbir yerde göremiyordu.
                                    *@
                                    @if (item.Status != "rejected")
                                    {
                                        <details class="relative inline-block align-middle">
                                            <summary class="list-none cursor-pointer text-yellow-600 hover:text-yellow-900" title="Reddet">
                                                <i class="fas fa-ban" aria-hidden="true"></i>
                                                <span class="sr-only">Reddet</span>
                                            </summary>
                                            <div class="absolute right-0 z-20 mt-2 w-64 rounded-lg border border-gray-200 bg-white p-3 shadow-lg text-left">
                                                <form asp-action="Reject" method="post">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <label class="block text-xs font-medium text-gray-600 mb-1">Red sebebi <span class="text-gray-400">(opsiyonel — işletme görür)</span></label>
                                                    <input type="text" name="reason" maxlength="500" placeholder="Örn: Kampanya koşulları belirsiz"
                                                           class="w-full border border-gray-300 rounded-md px-2 py-1.5 text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-yellow-500" />
                                                    <button type="submit" class="w-full bg-yellow-600 hover:bg-yellow-700 text-white text-sm font-medium py-1.5 rounded-md">
                                                        Kampanyayı Reddet
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" method="post" class="inline" data-confirm="“@item.Title” kampanyasını silmek istediğinize emin misiniz?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="text-red-600 hover:text-red-900" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-percent text-4xl text-gray-300 mb-3"></i>
                                <p>Kayıt bulunamadı.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", PaginationViewModel.From(Model, "kampanya"))
</div>
