@model KadirliApp.Application.Features.Ads.Commands.CreateAd.CreateAdCommand

@{
    ViewData["Title"] = "Yeni İlan Ekle";
}

<div class="p-6 max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">Yeni İlan Ekle</h1>
        <a asp-action="Index" class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Geri Dön
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="p-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Title -->
                    <div class="col-span-2">
                        <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-1">İlan Başlığı</label>
                        <input asp-for="Title" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border transition-colors" placeholder="Örn: Sahibinden Satılık Araba" />
                        <span asp-validation-for="Title" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- CategoryId -->
                    <div class="col-span-2 md:col-span-1">
                        <label asp-for="CategoryId" class="block text-sm font-semibold text-gray-700 mb-1">Kategori</label>
                        <select asp-for="CategoryId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border transition-colors" required>
                            <option value="">-- Kategori Seçiniz --</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-span-2 md:col-span-1">
                        <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-1">Fiyat (₺)</label>
                        <input asp-for="Price" type="number" step="0.01" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border transition-colors" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-span-2">
                        <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-1">Açıklama</label>
                        <textarea asp-for="Description" rows="4" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border transition-colors" placeholder="İlan detayları..."></textarea>
                        <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Seller Name -->
                    <div class="col-span-2 md:col-span-1">
                        <label asp-for="SellerName" class="block text-sm font-semibold text-gray-700 mb-1">Satıcı Adı</label>
                        <input asp-for="SellerName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border transition-colors" placeholder="Ad Soyad" />
                        <span asp-validation-for="SellerName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Contact Phone -->
                    <div class="col-span-2 md:col-span-1">
                        <label asp-for="ContactPhone" class="block text-sm font-semibold text-gray-700 mb-1">İletişim Telefonu</label>
                        <input asp-for="ContactPhone" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border transition-colors" placeholder="05XX XXX XX XX" />
                        <span asp-validation-for="ContactPhone" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <!-- Images -->
                    <div class="col-span-2 border-t border-gray-200 pt-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">İlan Görselleri <span class="text-gray-400 font-normal">(opsiyonel, ilk görsel kapak olur)</span></label>
                        <div class="flex items-start gap-4 flex-wrap">
                            <label for="imagesInput" class="flex flex-col items-center justify-center w-36 h-24 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors">
                                <i class="fas fa-images text-gray-400 text-lg mb-1"></i>
                                <span class="text-xs text-gray-500">Görsel Seç</span>
                                <input id="imagesInput" name="Images" type="file" accept="image/*" multiple class="hidden" data-images-input>
                            </label>
                            <div id="imagesPreviewWrap" class="flex gap-3 flex-wrap"></div>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex justify-end">
                    <button type="submit" class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-6 text-sm font-medium text-white shadow-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all">
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Context.Items["csp-nonce"]">
        function previewImages(input) {
            var wrap = document.getElementById('imagesPreviewWrap');
            wrap.innerHTML = '';
            if (!input.files) return;
            Array.from(input.files).forEach(function (file, idx) {
                var div = document.createElement('div');
                div.className = 'relative';
                var img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.className = 'h-24 w-36 rounded-lg border border-gray-200 object-cover';
                div.appendChild(img);
                if (idx === 0) {
                    var badge = document.createElement('span');
                    badge.textContent = 'Kapak';
                    badge.className = 'absolute top-1 left-1 bg-indigo-600 text-white text-[10px] px-1.5 py-0.5 rounded';
                    div.appendChild(badge);
                }
                wrap.appendChild(div);
            });
        }
    
    // ————————————————————————————————————————————————————————————
    // Faz 12.9 — bağlamalar satır içi on*= özniteliğinden BURAYA taşındı.
    // CSP `script-src 'self' 'nonce-…'` ile kurulu ve `unsafe-inline` YOK;
    // nonce yalnız script BLOKLARINI kapsar, öznitelikleri kapsamaz.
    // ————————————————————————————————————————————————————————————

        document.querySelector('[data-images-input]')?.addEventListener('change', function () {
            previewImages(this);
        });
</script>
}
