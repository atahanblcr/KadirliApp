@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.Ads.Dtos.AdResponseDto>

@{
    ViewData["Title"] = "İlan Yönetimi";

    // Faz 11.18 — toplu işlem çubuğu ve satır kutuları tek yerden kurulur.
    var bulkController = "AdsAdmin";
    var bulkToolbar = KadirliApp.Web.Models.BulkToolbarViewModel.Moderation("AdsAdmin", "ilan");
}

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">İlan Yönetimi</h1>
        <div class="flex items-center gap-2">
            <a asp-controller="AdCategoriesAdmin" asp-action="Index" class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 shadow-sm">
                <i class="fas fa-sitemap mr-2"></i> Kategoriler
            </a>
            <a asp-action="Create" class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Yeni Ekle
            </a>
        </div>
    </div>

    @{
        var q = ViewBag.Query as KadirliApp.Application.Features.Ads.Dtos.QueryAdDto;
        var categories = ViewBag.Categories as IEnumerable<KadirliApp.Application.Features.Ads.Queries.AdCategoryAdminDto>;
        var sortOptions = new (string Value, string Label)[]
        {
            ("newest", "En yeni"), ("oldest", "En eski"),
            ("price_asc", "Fiyat: artan"), ("price_desc", "Fiyat: azalan")
        };
        // 11.15c: Dashboard onay kuyruğu buraya ?status=pending ile geliyor.
        var statusOptions = new (string Value, string Label)[]
        {
            ("", "Tümü"), ("pending", "Bekleyen"), ("approved", "Onaylı"),
            ("rejected", "Reddedilen"), ("expired", "Süresi Dolmuş")
        };
        var hasFilter = q != null && (q.CategoryId.HasValue || q.MinPrice.HasValue
            || q.MaxPrice.HasValue || !string.IsNullOrWhiteSpace(q.Search)
            || !string.IsNullOrWhiteSpace(q.Status)
            || (!string.IsNullOrWhiteSpace(q.Sort) && q.Sort != "newest"));
    }

    @* Sorgu bu filtreleri baştan destekliyordu; panelde girecek alan yoktu. *@
    <form asp-action="Index" method="get" class="bg-white rounded-lg shadow p-4 flex flex-wrap items-end gap-3">
        <div class="flex flex-col gap-1">
            <label for="search" class="text-xs font-medium text-gray-600">Ara</label>
            <input type="text" id="search" name="search" value="@q?.Search" placeholder="Başlık veya açıklama"
                   class="w-56 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="flex flex-col gap-1">
            <label for="categoryId" class="text-xs font-medium text-gray-600">Kategori</label>
            <select id="categoryId" name="categoryId"
                    class="w-52 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <option value="">Tümü</option>
                @if (categories != null)
                {
                    @* ⚠️ selected ifadesi KESİN bool olmalı — dynamic dönerse Razor koşullu
                       öznitelik silmesini yapamaz ve selected="True" ile TÜM seçenekler işaretlenir. *@
                    foreach (var category in categories)
                    {
                        bool isSelected = q?.CategoryId == category.Id;
                        <option value="@category.Id" selected="@isSelected">@category.Name</option>
                    }
                }
            </select>
        </div>

        <div class="flex flex-col gap-1">
            <label for="status" class="text-xs font-medium text-gray-600">Durum</label>
            <select id="status" name="status"
                    class="w-40 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                @foreach (var option in statusOptions)
                {
                    bool isSelected = (q?.Status ?? "") == option.Value;
                    <option value="@option.Value" selected="@isSelected">@option.Label</option>
                }
            </select>
        </div>

        <div class="flex flex-col gap-1">
            <label for="minPrice" class="text-xs font-medium text-gray-600">Fiyat aralığı</label>
            <div class="flex items-center gap-1">
                <input type="number" id="minPrice" name="minPrice" value="@q?.MinPrice" placeholder="En az" step="any" min="0"
                       class="w-28 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span class="text-gray-400">–</span>
                <input type="number" name="maxPrice" value="@q?.MaxPrice" placeholder="En çok" step="any" min="0"
                       aria-label="En çok fiyat"
                       class="w-28 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
        </div>

        <div class="flex flex-col gap-1">
            <label for="sort" class="text-xs font-medium text-gray-600">Sıralama</label>
            <select id="sort" name="sort"
                    class="w-40 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                @foreach (var option in sortOptions)
                {
                    <option value="@option.Value" selected="@(q?.Sort == option.Value)">@option.Label</option>
                }
            </select>
        </div>

        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-indigo-600 rounded-lg shadow-sm hover:bg-indigo-700">
            <i class="fas fa-filter mr-1"></i> Filtrele
        </button>

        @if (hasFilter)
        {
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                Temizle
            </a>
        }
    </form>

    <div class="bg-white rounded-lg shadow overflow-hidden" data-bulk-scope>
        @* Faz 11.18: toplu onay/red/silme. Onay kuyruğundaki 40 ilan artık tek tek onaylanmıyor. *@
        <partial name="_BulkToolbar" model="bulkToolbar" />
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <partial name="_BulkSelectAll" />
                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">İlan Başlığı</th>
                        <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Fiyat", "price_asc", "price_desc", q?.Sort)' />
                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Telefon</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase" title="Mobil detay açılışı">Görüntülenme</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Durum</th>
                        <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Tarih", "oldest", "newest", q?.Sort, "Eskiden yeniye / yeniden eskiye")' />
                        <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model != null && Model.Items.Any())
                    {
                        foreach (var ad in Model.Items)
                        {
                            <tr>
                                <partial name="_BulkRowCheckbox" model="KadirliApp.Web.Models.BulkRowViewModel.For(bulkController, ad.Id)" />
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        @if (ad.ImageUrls != null && ad.ImageUrls.Any())
                                        {
                                            <div class="flex-shrink-0 h-10 w-10">
                                                <img class="h-10 w-10 rounded-full object-cover" src="@ad.ImageUrls.First()" alt="">
                                            </div>
                                        }
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900">@ad.Title</div>
                                            <div class="text-sm text-gray-500 truncate max-w-[16rem]">@ad.Description</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@PanelDisplay.TL(ad.Price)</div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@ad.ContactPhone</div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">@ad.ViewCount.ToString("N0")</div>
                                </td>
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <partial name="_StatusBadge" model="PanelDisplay.Status(ad.Status)" />
                                </td>
                                @* 11.15c: tarih+saat tek satırda ~110 px istiyordu; iki satıra
                                   alınınca işlem sütunu yatay kaydırma olmadan görünür hâle geliyor. *@
                                <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <div>@ad.CreatedAt.ToString("dd.MM.yyyy")</div>
                                    <div class="text-xs text-gray-400">@ad.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                @*
                                    Faz 11.15c: bu sütun panelin TEK metin-butonlu işlem sütunuydu
                                    (diğer 15 liste ikon kullanıyor) ve dört geniş buton tabloyu
                                    1437 px'e itip 1470 px'lik pencerede işlemleri ekran DIŞINDA
                                    bırakıyordu. İkon + title'a geçildi: hem tutarlı hem sığıyor.
                                *@
                                <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <div class="flex justify-end gap-3 items-center">
                                        @if (ad.Status.ToLower() != "approved")
                                        {
                                            <form asp-action="Approve" method="post" class="inline">
                                                <input type="hidden" name="id" value="@ad.Id" />
                                                <button type="submit" class="text-green-600 hover:text-green-900" title="Onayla">
                                                    <i class="fas fa-check" aria-hidden="true"></i>
                                                    <span class="sr-only">Onayla</span>
                                                </button>
                                            </form>
                                        }
                                        @if (ad.Status.ToLower() != "rejected")
                                        {
                                            <!-- Faz 10.14(1): red artık sebep sorarak RejectAdCommand'e gider (JS'siz details popover; ban-sebep deseni) -->
                                            <details class="relative inline-block align-middle">
                                                <summary class="list-none cursor-pointer text-yellow-600 hover:text-yellow-800" title="Reddet">
                                                    <i class="fas fa-ban" aria-hidden="true"></i>
                                                    <span class="sr-only">Reddet</span>
                                                </summary>
                                                <div class="absolute right-0 z-20 mt-2 w-64 rounded-lg border border-gray-200 bg-white p-3 shadow-lg text-left">
                                                    <form asp-action="Reject" method="post">
                                                        <input type="hidden" name="id" value="@ad.Id" />
                                                        <label class="block text-xs font-medium text-gray-600 mb-1">Red sebebi <span class="text-gray-400">(opsiyonel — kullanıcı görür)</span></label>
                                                        <input type="text" name="reason" maxlength="500" placeholder="Örn: İletişim bilgisi eksik"
                                                               class="w-full border border-gray-300 rounded-md px-2 py-1.5 text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-yellow-500" />
                                                        <button type="submit" class="w-full bg-yellow-600 hover:bg-yellow-700 text-white text-sm font-medium py-1.5 rounded-md">
                                                            İlanı Reddet
                                                        </button>
                                                    </form>
                                                </div>
                                            </details>
                                        }
                                        <a asp-action="Edit" asp-route-id="@ad.Id" class="text-indigo-600 hover:text-indigo-900" title="Düzenle">
                                            <i class="fas fa-edit" aria-hidden="true"></i>
                                            <span class="sr-only">Düzenle</span>
                                        </a>
                                        @* 11.15c: genel "emin misiniz?" yerine NEYİN silindiğini yazıyoruz (bkz. _Layout data-confirm). *@
                                        <form asp-action="Delete" method="post" class="inline"
                                              data-confirm="“@ad.Title” adlı ilanı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.">
                                            <input type="hidden" name="id" value="@ad.Id" />
                                            <button type="submit" class="text-red-600 hover:text-red-900" title="Sil">
                                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                <span class="sr-only">Sil</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-10 text-center text-sm text-gray-500">
                                Kayıtlı ilan bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", PaginationViewModel.From(Model, "ilan"))
    </div>
</div>
