@using KadirliApp.Web.Common
@model KadirliApp.Application.Features.News.Dtos.NewsSyncRunDto
@{
    ViewData["Title"] = "Senkron koşusu";
    var modeBadge = PanelDisplay.NewsSyncMode(Model.Mode);
    var statusBadge = PanelDisplay.NewsSyncStatus(Model.Status);
    var triggerBadge = PanelDisplay.NewsSyncTrigger(Model.Trigger);
}

<div class="mb-6">
    <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-800">
        <i class="fas fa-arrow-left mr-1"></i> Haber Senkronu
    </a>
    <h2 class="mt-1 text-2xl font-semibold text-gray-800">
        @Model.StartedAt.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss")
    </h2>
    <div class="mt-2 flex flex-wrap items-center gap-2">
        <partial name="_StatusBadge" model="modeBadge" />
        <partial name="_StatusBadge" model="triggerBadge" />
        <partial name="_StatusBadge" model="statusBadge" />
        @if (!string.IsNullOrWhiteSpace(Model.TriggeredByName))
        {
            <span class="text-sm text-gray-500">· @Model.TriggeredByName</span>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    @* ⚠️ Ham basılmaz: mesaj bir istisnadan geliyor ve içinde kaynaktan gelen metin
       olabilir (§7 madde 33'ün sınıfı). Razor kaçışı varsayılan, @Html.Raw yasak. *@
    <div class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-900">
        <div class="font-medium">Koşu hata bildirdi</div>
        <p class="mt-1 break-words">@Model.ErrorMessage</p>
        <p class="mt-2 text-xs text-red-800">
            Ayrıntısı <a asp-controller="ErrorLogsAdmin" asp-action="Index" asp-route-search="NEWS_SYNC"
                        class="underline">Hata Kayıtları</a> ekranında (aynı hata tekrarlarsa
            tek satırda sayılır).
        </p>
    </div>
}

<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    @foreach (var (label, value, hint) in new (string, int, string)[]
    {
        ("Okundu", Model.Fetched, "kaynaktan alınan gönderi"),
        ("Yeni", Model.Created, "ilk kez inen haber"),
        ("Güncellendi", Model.Updated, "kaynağı değişmiş haber"),
        ("Atlandı", Model.Skipped, "hiçbir alanı değişmemiş"),
        ("Düşürüldü", Model.MarkedGone, "kaynakta bulunamadı"),
        ("Geri geldi", Model.Restored, "kaynağa geri konmuş"),
        ("Hata", Model.Failed, "işlenemeyen sayfa/kayıt")
    })
    {
        <div class="rounded-lg border @(label == "Hata" && value > 0 ? "border-red-300 bg-red-50" : "border-gray-200 bg-white") p-4 shadow-sm">
            <div class="text-2xl font-semibold @(label == "Hata" && value > 0 ? "text-red-700" : "text-gray-900")">@value</div>
            <div class="text-sm font-medium text-gray-700">@label</div>
            <div class="mt-1 text-xs text-gray-500">@hint</div>
        </div>
    }
</div>

<div class="mt-6 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <h3 class="mb-3 text-sm font-semibold text-gray-800">Koşu ayrıntısı</h3>
    <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
        <div>
            <dt class="text-xs font-medium uppercase text-gray-500">Başlangıç</dt>
            <dd class="text-gray-900">@Model.StartedAt.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss")</dd>
        </div>
        <div>
            <dt class="text-xs font-medium uppercase text-gray-500">Bitiş</dt>
            <dd class="text-gray-900">
                @(Model.CompletedAt is { } completed
                    ? completed.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss")
                    : "Devam ediyor")
            </dd>
        </div>
        <div>
            <dt class="text-xs font-medium uppercase text-gray-500">İmleç (başlangıç)</dt>
            @* 🔑 İmleç, "hangi haberler bir daha sorulmayacak" sorusunun cevabı — bir arıza
               araştırmasında en çok işe yarayan iki alan bunlar. *@
            <dd class="text-gray-900">
                @(Model.CursorFrom is { } cursorFrom ? cursorFrom.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss") : "—")
            </dd>
        </div>
        <div>
            <dt class="text-xs font-medium uppercase text-gray-500">İmleç (bitiş)</dt>
            <dd class="text-gray-900">
                @(Model.CursorTo is { } cursorTo ? cursorTo.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss") : "—")
            </dd>
        </div>
    </dl>
    <p class="mt-3 text-xs text-gray-500">
        İmleç kaynaktaki <strong>son değişiklik zamanını</strong> takip eder. Bir sayfa hata
        verirse imleç <strong>bilerek ilerletilmez</strong> — ilerletilseydi o sayfadaki
        haberler bir daha hiç sorulmazdı.
    </p>
</div>
