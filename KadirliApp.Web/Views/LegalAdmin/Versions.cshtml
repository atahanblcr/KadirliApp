@using KadirliApp.Web.Common
@model List<KadirliApp.Application.Features.Legal.Dtos.LegalDocumentVersionAdminDto>
@{
    var doc = (KadirliApp.Application.Features.Legal.Dtos.LegalDocumentAdminDto)ViewBag.Document;
    ViewData["Title"] = $"{doc.Title} — Sürümler";

    var draft = Model.FirstOrDefault(v => v.IsDraft);
    var live = Model.FirstOrDefault(v => v.IsLive);
}

<div class="mb-6">
    <a asp-action="Index" class="text-sm text-blue-600 hover:underline">
        <i class="fas fa-arrow-left mr-1"></i> Hukuki Metinler
    </a>
    <h2 class="mt-2 text-2xl font-semibold text-gray-800">@doc.Title</h2>
    <p class="mt-1 text-sm text-gray-500">
        @doc.Type · @Model.Count sürüm
        @if (live is not null)
        {
            <span>· yayında <strong>v@(live.VersionNumber)</strong>, @live.GrantedCount kişi onayladı</span>
        }
    </p>
</div>

@* ── Yeni sürüm / taslak düzenleme ────────────────────────────────────────────────
   🔴 Yayınlanmış sürüm İÇİN FORM ÇİZİLMEZ (12.10'un _ModerationStatusField deseni):
   kapı komutta da var ama görünümde de olmalı — yöneticiye yapamayacağı bir işi
   teklif etmek, "işlevsiz buton yok" kuralının panel karşılığıdır. *@
@if (draft is not null)
{
    <div class="mb-6 rounded-lg border border-purple-200 bg-purple-50 p-4">
        <h3 class="text-sm font-semibold text-purple-900">
            <i class="fas fa-pen mr-1"></i> Taslak: v@(draft.VersionNumber)
        </h3>
        <p class="mt-1 text-xs text-purple-800">
            Bu metin <strong>henüz yayında değil</strong> — kimse görmüyor, kimse onaylamadı.
            Yayınladığınız an kayıt ekranı bunu sormaya başlar.
        </p>

        <form asp-action="UpdateVersion" method="post" class="mt-4 space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@draft.Id" />
            <input type="hidden" name="documentId" value="@doc.Id" />

            <div>
                <label class="block text-xs font-medium text-gray-700">Özet (onay kutusunun yanındaki cümle)</label>
                <input name="Summary" value="@draft.Summary" maxlength="500"
                       class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"
                       placeholder="Kişisel verilerimin işlenmesini kabul ediyorum" />
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700">Metin (HTML)</label>
                <textarea name="Body" rows="14" required
                          class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-xs">@draft.Body</textarea>
            </div>

            <div class="flex flex-wrap items-end gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700">Yürürlük tarihi</label>
                    <input name="EffectiveFrom" type="date" value="@draft.EffectiveFrom.ToString("yyyy-MM-dd")"
                           class="mt-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm" />
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" name="RequiresReconsent" value="true" @(draft.RequiresReconsent ? "checked" : "")
                           class="rounded border-gray-300" />
                    <input type="hidden" name="RequiresReconsent" value="false" />
                    Yeniden onay gerektirir
                </label>

                <button type="submit"
                        class="rounded-lg bg-gray-700 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
                    Taslağı kaydet
                </button>

                @* 🔴 Yayınla butonu bu formun DIŞINDA (aşağıda) — iç içe form etiketi geçersiz
                   HTML'dir ve tarayıcı içtekini sessizce atar: buton çizilir, tıklanır,
                   hiçbir şey olmaz ("işlevsiz buton"un en sinsi hâli). Bağ `form=` ile kurulu. *@
                <button type="submit" form="publish-draft"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
                    <i class="fas fa-file-contract mr-1"></i> Yayınla
                </button>
            </div>
        </form>

        @* 🐛 `data-confirm` FORMUN üzerinde, butonun değil — ilk yazımda butona konmuştu ve
           `PanelConfirmDialogTests` yakaladı: panel.js'in dinleyicisi **submit olayında
           formun** özniteliğine bakıyor, yani butonda duran bir `data-confirm` onay
           penceresini SESSİZCE hiç açmaz. Sonuç, geri alınamaz bir aksiyonun (yayınlama)
           tek tıkla, uyarısız koşması olurdu. *@
        <form asp-action="Publish" method="post" id="publish-draft"
              data-confirm="@($"\"{doc.Title}\" v{draft.VersionNumber} yayınlanacak. Bu andan sonra kayıt olan herkes BU metne rıza verecek ve metin bir daha değiştirilemeyecek. Emin misiniz?")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@draft.Id" />
            <input type="hidden" name="documentId" value="@doc.Id" />
        </form>
        <p class="mt-3 text-xs text-purple-700">
            <strong>"Yeniden onay gerektirir"</strong> yalnız <strong>kapsam değiştiyse</strong>
            işaretlenir (yeni bir veri işleme amacı, yeni bir alıcı grubu). Yazım hatası
            düzeltmesinde işaretlemeyin — yoksa bütün kullanıcıları gereksiz yere
            yeniden onay ekranına düşürürsünüz.
        </p>
    </div>
}
else
{
    <div class="mb-6 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
        <h3 class="text-sm font-semibold text-gray-800">
            <i class="fas fa-file-lines mr-1"></i> Yeni sürüm aç
        </h3>
        <p class="mt-1 text-xs text-gray-500">
            Yayınlanmış metin değiştirilemez. Metni güncellemenin tek yolu yeni bir sürüm
            açmaktır; eski sürüm ve ona verilmiş rızalar <strong>olduğu gibi kalır</strong>.
        </p>

        <form asp-action="CreateVersion" method="post" class="mt-4 space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="DocumentId" value="@doc.Id" />

            <div>
                <label class="block text-xs font-medium text-gray-700">Özet (onay kutusunun yanındaki cümle)</label>
                <input name="Summary" maxlength="500"
                       class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"
                       placeholder="Kişisel verilerimin işlenmesini kabul ediyorum" />
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700">Metin (HTML)</label>
                <textarea name="Body" rows="14" required
                          class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-xs"
                          placeholder="&lt;p&gt;…&lt;/p&gt;">@(live?.Body)</textarea>
                @if (live is not null)
                {
                    <p class="mt-1 text-xs text-gray-400">
                        Yayındaki v@(live.VersionNumber) metniyle dolduruldu — üzerinde düzenleyin.
                    </p>
                }
            </div>

            <div class="flex flex-wrap items-end gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700">Yürürlük tarihi</label>
                    <input name="EffectiveFrom" type="date" value="@DateTime.UtcNow.AddHours(3).ToString("yyyy-MM-dd")"
                           class="mt-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm" />
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" name="RequiresReconsent" value="true" class="rounded border-gray-300" />
                    <input type="hidden" name="RequiresReconsent" value="false" />
                    Yeniden onay gerektirir
                </label>

                <button type="submit"
                        class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
                    Taslak oluştur
                </button>
            </div>
        </form>
    </div>
}

@* ── Sürüm geçmişi ──────────────────────────────────────────────────────────── *@
<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-gray-800">Sürüm geçmişi</h3>
    </div>

    @if (!Model.Any())
    {
        <p class="px-6 py-8 text-center text-sm text-gray-400">
            Bu belgenin henüz hiç sürümü yok — kayıt ekranında <strong>gösterilmiyor</strong>.
        </p>
    }
    else
    {
        <div class="divide-y divide-gray-100">
        @foreach (var v in Model)
        {
            <div class="px-6 py-4">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="font-medium text-gray-800">v@(v.VersionNumber)</span>

                    @if (v.IsLive)
                    {
                        <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Yayında</span>
                    }
                    else if (v.IsDraft)
                    {
                        <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-800">Taslak</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-gray-200 px-2 py-0.5 text-xs font-medium text-gray-700">Yürürlükten kalktı</span>
                    }

                    @if (v.RequiresReconsent)
                    {
                        <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Yeniden onay ister</span>
                    }

                    <span class="text-xs text-gray-500">
                        @if (v.PublishedAt is { } p)
                        {
                            <text>@p.AddHours(3).ToString("dd.MM.yyyy HH:mm")'de yayınlandı</text>
                            @if (!string.IsNullOrEmpty(v.PublishedByName))
                            {
                                <text> · @v.PublishedByName</text>
                            }
                        }
                        else
                        {
                            <text>henüz yayınlanmadı</text>
                        }
                    </span>
                </div>

                @* Sayılar gerçek rıza sorgusundan. "Reddetti" ayrı gösterilir: "sormadık" ile
                   "sorduk, hayır dedi" KVKK'da farklı şeylerdir. *@
                <div class="mt-1 text-xs text-gray-500">
                    @v.GrantedCount onayladı · @v.DeniedCount reddetti
                    @if (v.SupersededAt is { } s)
                    {
                        <text> · @s.AddHours(3).ToString("dd.MM.yyyy HH:mm")'de yürürlükten kalktı</text>
                    }
                </div>

                @if (!string.IsNullOrEmpty(v.Summary))
                {
                    <p class="mt-2 text-sm text-gray-700">@v.Summary</p>
                }

                <details class="mt-2">
                    <summary class="cursor-pointer text-xs font-medium text-blue-600">Metni önizle</summary>
                    @* ⚠️ Metin panelden gelen HTML — önizlemede OLDUĞU GİBİ çizilir ki yönetici
                       vatandaşın GÖRECEĞİ şeyi görsün; temizlenmiş bir önizleme, yayınlanacak
                       metinden farklı bir şey gösterir ve önizlemenin amacını yok ederdi.
                       🔑 Ham HTML'in burada güvenli olmasının sebebi 12.9'un CSP'si:
                       `script-src`'ta 'unsafe-inline' YOK ve nonce'suz hiçbir betik etiketi
                       ya da `on*=` işleyicisi çalışmaz (§7 madde 51). Yani metne betik gömen
                       bir moderatör, çalışmayan bir metin gömmüş olur.
                       ⚠️ Bu yorumda "betik etiketi" yazıyor, açı parantezli hâli DEĞİL:
                       `PanelExternalOriginTests` görünümün ham metnini tarıyor ve bir
                       YORUMDAKİ örnek bile nonce'suz blok sayılıp testi kırıyor (ölçüldü). *@
                    @* ⚠️ `prose` KULLANILMADI: @tailwindcss/typography bu projede kurulu değil
                       (tailwind.config.js → plugins: []), yani o sınıflar hiçbir şey yapmaz ve
                       "stil uyguladım" yanılsaması bırakırdı — 12.9'un "eksik sınıf hata
                       vermez, yalnız stil uygulanmaz" dersi. *@
                    <div class="mt-2 max-w-none space-y-2 rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm leading-relaxed text-gray-700">
                        @Html.Raw(v.Body)
                    </div>
                </details>
            </div>
        }
        </div>
    }
</div>
