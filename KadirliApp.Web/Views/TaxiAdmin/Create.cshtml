@model KadirliApp.Application.Features.Taxis.Commands.CreateTaxiDriverCommand
@{
    ViewData["Title"] = "Yeni Taksici Ekle";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Yeni Taksici Ekle</h2>
            <p class="text-sm text-gray-500 mt-1">Sisteme yeni bir taksici kaydı ekleyin. Kayıt sonrası listeden doğrulama yapabilirsiniz.</p>
        </div>
        <div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-300 bg-white shadow-sm">
                <i class="fas fa-arrow-left mr-2"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div>
                    <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">Ad Soyad <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Mehmet Yılmaz" required />
                    <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Phone -->
                <div>
                    <label asp-for="Phone" class="block text-sm font-semibold text-gray-700 mb-2">Telefon <span class="text-red-500">*</span></label>
                    <input asp-for="Phone" type="tel" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="+905XXXXXXXXX" required />
                    <span asp-validation-for="Phone" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Plaka -->
                <div>
                    <label asp-for="Plaka" class="block text-sm font-semibold text-gray-700 mb-2">Plaka</label>
                    <input asp-for="Plaka" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm uppercase" placeholder="Örn: 80 T 1234" />
                    <span asp-validation-for="Plaka" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- VehicleInfo -->
                <div>
                    <label asp-for="VehicleInfo" class="block text-sm font-semibold text-gray-700 mb-2">Araç Bilgisi</label>
                    <input asp-for="VehicleInfo" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Fiat Egea, Sarı, 2022" />
                    <span asp-validation-for="VehicleInfo" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-200 mt-6 flex justify-end">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-lg shadow-md transition-all flex items-center">
                    <i class="fas fa-save mr-2"></i> Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
