@model KadirliApp.Application.Features.Taxis.Commands.UpdateTaxiDriverCommand
@{
    ViewData["Title"] = "Taksici Düzenle";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Taksici Düzenle</h2>
            <p class="text-sm text-gray-500 mt-1">Taksici bilgilerini güncelleyebilirsiniz.</p>
        </div>
        <div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-300 bg-white shadow-sm">
                <i class="fas fa-arrow-left mr-2"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div>
                    <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">Ad Soyad <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" required />
                    <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Phone -->
                <div>
                    <label asp-for="Phone" class="block text-sm font-semibold text-gray-700 mb-2">Telefon <span class="text-red-500">*</span></label>
                    <input asp-for="Phone" type="tel" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" required />
                    <span asp-validation-for="Phone" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Plaka -->
                <div>
                    <label asp-for="Plaka" class="block text-sm font-semibold text-gray-700 mb-2">Plaka</label>
                    <input asp-for="Plaka" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm uppercase" />
                    <span asp-validation-for="Plaka" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- VehicleInfo -->
                <div>
                    <label asp-for="VehicleInfo" class="block text-sm font-semibold text-gray-700 mb-2">Araç Bilgisi</label>
                    <input asp-for="VehicleInfo" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" />
                    <span asp-validation-for="VehicleInfo" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- IsActive -->
                <div class="col-span-1 md:col-span-2">
                    <label class="flex items-center gap-3">
                        <input asp-for="IsActive" type="checkbox" class="h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                        <span class="text-sm font-semibold text-gray-700">Aktif (pasif taksiciler uygulamada listelenmez)</span>
                    </label>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-200 mt-6 flex justify-end">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-lg shadow-md transition-all flex items-center">
                    <i class="fas fa-save mr-2"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>
