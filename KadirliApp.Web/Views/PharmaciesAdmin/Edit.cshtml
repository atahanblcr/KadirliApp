@model KadirliApp.Application.Features.Pharmacies.Dtos.UpdatePharmacyDto
@{
    ViewData["Title"] = "Eczane Düzenle";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-semibold text-gray-800">Eczane Düzenle</h2>
            <p class="text-sm text-gray-500 mt-1">Eczane bilgilerini güncelleyin.</p>
        </div>
        <div>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 font-medium">
                <i class="fas fa-arrow-left mr-1"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-lg overflow-hidden">
        <form asp-action="Edit" method="post" class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <div class="md:col-span-2">
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">Eczane Adı <span class="text-red-500">*</span></label>
                    <input asp-for="Name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" required />
                    <span asp-validation-for="Name" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PharmacistName" class="block text-sm font-medium text-gray-700 mb-2">Eczacı Adı Soyadı</label>
                    <input asp-for="PharmacistName" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" />
                    <span asp-validation-for="PharmacistName" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-gray-700 mb-2">Telefon Numarası</label>
                    <input asp-for="Phone" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" />
                    <span asp-validation-for="Phone" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Address" class="block text-sm font-medium text-gray-700 mb-2">Adres</label>
                    <textarea asp-for="Address" rows="3" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900"></textarea>
                    <span asp-validation-for="Address" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Latitude" class="block text-sm font-medium text-gray-700 mb-2">Enlem (Latitude)</label>
                    <input asp-for="Latitude" type="text" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" />
                    <span asp-validation-for="Latitude" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Longitude" class="block text-sm font-medium text-gray-700 mb-2">Boylam (Longitude)</label>
                    <input asp-for="Longitude" type="text" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" />
                    <span asp-validation-for="Longitude" class="text-sm text-red-600 mt-1 block"></span>
                </div>
                
                <div>
                    <label asp-for="WorkingHours" class="block text-sm font-medium text-gray-700 mb-2">Çalışma Saatleri</label>
                    <input asp-for="WorkingHours" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow shadow-sm text-gray-900" />
                    <span asp-validation-for="WorkingHours" class="text-sm text-red-600 mt-1 block"></span>
                </div>

                <div class="flex items-center mt-6">
                    <input asp-for="IsActive" type="checkbox" value="true" class="h-5 w-5 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded cursor-pointer" />
                    <label asp-for="IsActive" class="ml-3 block text-sm font-medium text-gray-700 cursor-pointer">
                        Aktif olarak gösterilsin
                    </label>
                </div>

            </div>

            <div class="mt-8 pt-5 border-t border-gray-200 flex justify-end gap-3">
                <a asp-action="Index" class="px-6 py-2.5 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm">
                    İptal
                </a>
                <button type="submit" class="px-6 py-2.5 border border-transparent rounded-lg shadow-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Güncelle
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
