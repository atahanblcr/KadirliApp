@model KadirliApp.Web.Models.StatusCodeViewModel
@{
    ViewData["Title"] = Model.Title;
    // Oturumu olmayan biri de buraya düşebilir (ör. yanlış adres). Kenar çubuğu
    // menü sağlayıcıyı çağırdığı için giriş yapılmamışken boş menü çizilir — sorun değil.
}

<div class="mx-auto max-w-xl py-16 text-center">
    <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100 text-gray-400">
        <i class="fas @Model.Icon text-3xl" aria-hidden="true"></i>
    </div>

    <p class="text-sm font-semibold uppercase tracking-wide text-gray-400">Hata @Model.Code</p>
    <h1 class="mt-2 text-2xl font-bold text-gray-900">@Model.Title</h1>
    <p class="mt-3 text-gray-600">@Model.Description</p>

    @if (!string.IsNullOrEmpty(Model.OriginalPath))
    {
        <p class="mt-4 break-all rounded-lg bg-gray-50 px-4 py-2 text-xs text-gray-500">
            İstenen adres: <code>@Model.OriginalPath</code>
        </p>
    }

    <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a asp-controller="Dashboard" asp-action="Index"
           class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
            <i class="fas fa-home" aria-hidden="true"></i>Panele dön
        </a>
        <a asp-controller="Account" asp-action="Login"
           class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
            <i class="fas fa-right-to-bracket" aria-hidden="true"></i>Giriş sayfası
        </a>
    </div>
</div>
