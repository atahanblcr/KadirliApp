@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.ErrorLogs.Dtos.ErrorLogResponseDto>
@{
    ViewData["Title"] = "Hata Kayıtları";

    var sources = ViewBag.Sources as List<(string Key, string Label)> ?? new();
    var levels = ViewBag.Levels as List<(string Key, string Label)> ?? new();

    string? selectedSource = ViewBag.Source;
    string? selectedLevel = ViewBag.Level;
    bool? resolved = ViewBag.Resolved;
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
    string? search = ViewBag.Search;
    string? sort = ViewBag.Sort;

    var hasFilter = selectedSource != null || selectedLevel != null || resolved != null
                    || from != null || to != null || !string.IsNullOrWhiteSpace(search);
}

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Hata Kayıtları</h2>
        <p class="text-sm text-gray-500 mt-1">
            Sunucuda, panelde ve mobil uygulamada oluşan hatalar. Aynı hata tekrar ettiğinde
            yeni satır açılmaz — <strong>adet</strong> sütunu artar.
        </p>
    </div>
    <partial name="_ExportCsvButton" />
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
    <form asp-action="Index" method="get" class="p-4 border-b border-gray-200 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6">
        <div>
            <label for="source" class="block text-xs font-medium text-gray-600 mb-1">Kaynak</label>
            <select id="source" name="source" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">Tümü</option>
                @foreach (var s in sources)
                {
                    <option value="@s.Key" selected="@(s.Key == selectedSource)">@s.Label</option>
                }
            </select>
        </div>

        <div>
            <label for="level" class="block text-xs font-medium text-gray-600 mb-1">Seviye</label>
            <select id="level" name="level" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">Tümü</option>
                @foreach (var l in levels)
                {
                    <option value="@l.Key" selected="@(l.Key == selectedLevel)">@l.Label</option>
                }
            </select>
        </div>

        <div>
            <label for="resolved" class="block text-xs font-medium text-gray-600 mb-1">Durum</label>
            <select id="resolved" name="resolved" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">Tümü</option>
                <option value="false" selected="@(resolved == false)">Açık</option>
                <option value="true" selected="@(resolved == true)">Çözüldü</option>
            </select>
        </div>

        <div>
            <label for="from" class="block text-xs font-medium text-gray-600 mb-1">Başlangıç</label>
            <input id="from" name="from" type="date" value="@(from?.ToString("yyyy-MM-dd"))"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
            <label for="to" class="block text-xs font-medium text-gray-600 mb-1">Bitiş</label>
            <input id="to" name="to" type="date" value="@(to?.ToString("yyyy-MM-dd"))"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
            <label for="search" class="block text-xs font-medium text-gray-600 mb-1">Ara</label>
            <input id="search" name="search" type="text" value="@search" placeholder="Mesaj, kod, yol veya traceId"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        @if (!string.IsNullOrWhiteSpace(sort))
        {
            @* Sıralama filtre formundan kaybolmamalı — aksi hâlde "Filtrele"ye basınca sıra sıfırlanır. *@
            <input type="hidden" name="sort" value="@sort" />
        }

        <div class="sm:col-span-2 lg:col-span-6 flex flex-wrap items-center gap-3">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                <i class="fas fa-filter mr-2"></i> Filtrele
            </button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900">
                    <i class="fas fa-times mr-1"></i> Filtreleri temizle
                </a>
            }
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Kaynak</th>
                    <th scope="col" class="px-4 py-3 font-medium">Seviye</th>
                    <th scope="col" class="px-4 py-3 font-medium">Hata</th>
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Adet", "count_asc", "count_desc", sort)' />
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("İlk görülme", "first_seen_asc", "first_seen_desc", sort)' />
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Son görülme", "last_seen_asc", "last_seen_desc", sort)' />
                    <th scope="col" class="px-4 py-3 font-medium">Durum</th>
                    <th scope="col" class="px-4 py-3 font-medium text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var sourceBadge = PanelDisplay.ErrorSource(item.Source);
                        var levelBadge = PanelDisplay.ErrorLevel(item.Level);
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors align-top">
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 rounded px-2.5 py-0.5 text-xs font-medium @sourceBadge.Css">
                                    <i class="fas @sourceBadge.Icon"></i> @sourceBadge.Label
                                </span>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 rounded px-2.5 py-0.5 text-xs font-medium @levelBadge.Css">
                                    <i class="fas @levelBadge.Icon"></i> @levelBadge.Label
                                </span>
                            </td>
                            <td class="px-4 py-4 max-w-md">
                                @* ⚠️ Ham basılmaz: mesajın bir kısmı İSTEMCİDEN geliyor.
                                   Razor kaçışı varsayılan — burada @Html.Raw kullanmak
                                   panelde depolanmış XSS açardı. *@
                                <div class="font-medium text-gray-900 break-words">@item.Message</div>
                                <div class="mt-1 text-xs text-gray-500 break-all">
                                    <span class="font-mono">@item.Code</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Path))
                                    {
                                        <span> · @item.Method @item.Path</span>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center justify-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-800">
                                    @item.OccurrenceCount
                                </span>
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-gray-700">
                                @item.FirstSeenAt.AddHours(3).ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-gray-900">
                                @item.LastSeenAt.AddHours(3).ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap">
                                @if (item.IsResolved)
                                {
                                    <span class="inline-flex items-center gap-1 rounded px-2.5 py-0.5 text-xs font-medium bg-green-100 text-green-800">
                                        <i class="fas fa-circle-check"></i> Çözüldü
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 rounded px-2.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">
                                        <i class="fas fa-circle-exclamation"></i> Açık
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-4 whitespace-nowrap text-right">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="text-blue-600 hover:text-blue-800 font-medium">
                                    <i class="fas fa-magnifying-glass mr-1"></i> Ayrıntı
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-6 py-8 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-circle-check text-4xl text-green-300 mb-3"></i>
                                <p>@(hasFilter ? "Bu filtreye uyan hata kaydı yok." : "Kayıtlı hata yok — iyi haber.")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", PaginationViewModel.From(Model, "hata kaydı"))
</div>
