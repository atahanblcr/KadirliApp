@model KadirliApp.Web.Models.LookupsIndexViewModel
@{
    ViewData["Title"] = "Tanımlar";
    string? Open(string section) => Model.OpenSection == section ? "open" : null;
}

<div class="mb-6">
    <h2 class="text-2xl font-semibold text-gray-800">Tanımlar</h2>
    <p class="text-sm text-gray-500 mt-1">
        Mahalle, il/ilçe, mezarlık, cami ve kategori sözlükleri. Mobil bu listeleri <code>/v1/neighborhoods</code>, <code>/v1/deaths/cemeteries|mosques</code>, <code>/v1/events/categories</code> uçlarından okur — kaydetme sonrası cache otomatik tazelenir.
        <span class="block text-xs text-gray-400 mt-1">Silme yok: bu kayıtlara vefat/kullanıcı/etkinlik/mekan kayıtları bağlanır; mahalleler pasife alınarak listeden düşürülür.</span>
    </p>
</div>

<div class="space-y-4">

    @* ---------------- Mahalleler ---------------- *@
    <details class="bg-white rounded-lg border border-gray-200 shadow-sm" open="@Open("neighborhoods")">
        <summary class="px-6 py-4 cursor-pointer flex items-center gap-3 hover:bg-gray-50 rounded-lg">
            <i class="fas fa-map-signs text-indigo-500 w-5"></i>
            <span class="font-medium text-gray-800">Mahalleler</span>
            <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full">@Model.Neighborhoods.Count</span>
            <span class="text-xs text-gray-400 ml-auto">@Model.Neighborhoods.Count(n => !n.IsActive) pasif</span>
        </summary>
        <div class="border-t border-gray-100 px-6 pb-6">
            <form asp-action="NeighborhoodCreate" method="post" class="flex flex-wrap items-end gap-3 py-4 border-b border-gray-100">
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Yeni Mahalle Adı <span class="text-red-500">*</span></label>
                    <input name="name" required maxlength="100" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" placeholder="Örn: Yeni Mahalle" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Tip</label>
                    <select name="type" class="block rounded-md border-gray-300 text-sm py-2 px-3 border">
                        <option value="">—</option>
                        <option value="merkez" selected>Merkez</option>
                        <option value="belde">Belde</option>
                        <option value="koy">Köy</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                    <input name="displayOrder" type="number" value="0" class="block w-20 rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <button type="submit" class="rounded-md bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Ekle</button>
            </form>
            <table class="w-full text-sm mt-2">
                <thead>
                    <tr class="text-left text-xs text-gray-500 uppercase">
                        <th class="py-2 pr-4">Ad</th>
                        <th class="py-2 pr-4">Tip</th>
                        <th class="py-2 pr-4">Sıra</th>
                        <th class="py-2 pr-4">Sakin</th>
                        <th class="py-2 pr-4">Durum</th>
                        <th class="py-2 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var n in Model.Neighborhoods)
                    {
                        <tr class="@(n.IsActive ? null : "opacity-60")">
                            <td class="py-2.5 pr-4">
                                <span class="font-medium text-gray-900">@n.Name</span>
                                <span class="text-xs text-gray-400 ml-1">@n.Slug</span>
                            </td>
                            <td class="py-2.5 pr-4 text-gray-600">@(n.Type ?? "-")</td>
                            <td class="py-2.5 pr-4 text-gray-600">@n.DisplayOrder</td>
                            <td class="py-2.5 pr-4 text-gray-600" title="Bu mahalleyi birincil seçen kullanıcı sayısı">@n.ResidentCount</td>
                            <td class="py-2.5 pr-4">
                                @if (n.IsActive)
                                {
                                    <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded">Aktif</span>
                                }
                                else
                                {
                                    <span class="bg-gray-200 text-gray-600 text-xs font-medium px-2 py-0.5 rounded">Pasif</span>
                                }
                            </td>
                            <td class="py-2.5 text-right">
                                <details class="relative inline-block text-left">
                                    <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                                    <form asp-action="NeighborhoodUpdate" method="post" class="absolute right-0 z-10 mt-2 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ad</label>
                                            <input name="name" required maxlength="100" value="@n.Name" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Tip</label>
                                                <select name="type" class="block w-28 rounded-md border-gray-300 text-sm py-1.5 px-2 border">
                                                    <option value="">—</option>
                                                    <option value="merkez" selected="@(n.Type == "merkez" ? "selected" : null)">Merkez</option>
                                                    <option value="belde" selected="@(n.Type == "belde" ? "selected" : null)">Belde</option>
                                                    <option value="koy" selected="@(n.Type == "koy" ? "selected" : null)">Köy</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                                                <input name="displayOrder" type="number" value="@n.DisplayOrder" class="block w-20 rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                            </div>
                                            <label class="flex items-center gap-1.5 text-xs text-gray-700 mt-4">
                                                <input type="checkbox" name="isActive" value="true" checked="@(n.IsActive ? "checked" : null)" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                                                <span>Aktif</span>
                                            </label>
                                        </div>
                                        @if (n.ResidentCount > 0)
                                        {
                                            <p class="text-xs text-amber-600">@n.ResidentCount kullanıcının birincil mahallesi — pasife almak mobil listelerden düşürür, kullanıcı kayıtları bozulmaz.</p>
                                        }
                                        <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

    @* ---------------- İl / ilçe (Faz 12.4) ---------------- *@
    <details class="bg-white rounded-lg border border-gray-200 shadow-sm" open="@Open("districts")">
        <summary class="px-6 py-4 cursor-pointer flex items-center gap-3 hover:bg-gray-50 rounded-lg">
            <i class="fas fa-city text-indigo-500 w-5"></i>
            <span class="font-medium text-gray-800">İl / İlçeler</span>
            <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full">@Model.Districts.Count</span>
            <span class="text-xs text-gray-400 ml-auto">Etkinlik formunda seçilir</span>
        </summary>
        <div class="border-t border-gray-100 px-6 pb-6">
            <p class="text-xs text-gray-500 pt-4">
                Etkinliğin konumu bu listeden seçilir. Mobilde etkinlik kartındaki konum rozeti ve
                <strong>Kadirli / Osmaniye / Çevre iller</strong> süzgeci buradan beslenir.
            </p>
            <form asp-action="DistrictCreate" method="post" class="flex flex-wrap items-end gap-3 py-4 border-b border-gray-100">
                <div class="grow min-w-40">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">İl <span class="text-red-500">*</span></label>
                    <input name="provinceName" required maxlength="100" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" placeholder="Örn: Adana" />
                </div>
                <div class="grow min-w-40">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">İlçe <span class="text-red-500">*</span></label>
                    <input name="name" required maxlength="100" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" placeholder="Örn: Ceyhan" />
                </div>
                <label class="flex items-center gap-1.5 text-xs text-gray-700 mb-2.5">
                    <input type="checkbox" name="isCenter" value="true" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                    <span>İl merkezi</span>
                </label>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                    <input name="displayOrder" type="number" value="20" class="block w-20 rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <button type="submit" class="rounded-md bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Ekle</button>
            </form>
            <table class="w-full text-sm mt-2">
                <thead>
                    <tr class="text-left text-xs text-gray-500 uppercase">
                        <th class="py-2 pr-4">İl / İlçe</th>
                        <th class="py-2 pr-4">Görünen ad</th>
                        <th class="py-2 pr-4">Sıra</th>
                        <th class="py-2 pr-4">Etkinlik</th>
                        <th class="py-2 pr-4">Durum</th>
                        <th class="py-2 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var d in Model.Districts)
                    {
                        <tr class="@(d.IsActive ? null : "opacity-60")">
                            <td class="py-2.5 pr-4">
                                <span class="font-medium text-gray-900">@d.ProvinceName / @d.Name</span>
                                @if (d.IsHome)
                                {
                                    <span class="ml-1 bg-indigo-100 text-indigo-700 text-xs font-medium px-2 py-0.5 rounded" title="Uygulamanın kendi ilçesi">Bizim ilçe</span>
                                }
                                @if (d.IsCenter)
                                {
                                    <span class="ml-1 bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded">Merkez</span>
                                }
                            </td>
                            <td class="py-2.5 pr-4 text-gray-600">@d.LocationLabel</td>
                            <td class="py-2.5 pr-4 text-gray-600">@d.DisplayOrder</td>
                            <td class="py-2.5 pr-4 text-gray-600" title="Bu ilçeye bağlı etkinlik sayısı">@d.EventCount</td>
                            <td class="py-2.5 pr-4">
                                @if (d.IsActive)
                                {
                                    <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded">Aktif</span>
                                }
                                else
                                {
                                    <span class="bg-gray-200 text-gray-600 text-xs font-medium px-2 py-0.5 rounded">Pasif</span>
                                }
                            </td>
                            <td class="py-2.5 text-right">
                                <details class="relative inline-block text-left">
                                    <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                                    <form asp-action="DistrictUpdate" method="post" class="absolute right-0 z-10 mt-2 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">İl</label>
                                            <input name="provinceName" required maxlength="100" value="@d.ProvinceName" readonly="@(d.IsHome ? "readonly" : null)" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border @(d.IsHome ? "bg-gray-100" : null)" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">İlçe</label>
                                            <input name="name" required maxlength="100" value="@d.Name" readonly="@(d.IsHome ? "readonly" : null)" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border @(d.IsHome ? "bg-gray-100" : null)" />
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                                                <input name="displayOrder" type="number" value="@d.DisplayOrder" class="block w-20 rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                            </div>
                                            <label class="flex items-center gap-1.5 text-xs text-gray-700 mt-4">
                                                <input type="checkbox" name="isCenter" value="true" checked="@(d.IsCenter ? "checked" : null)" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                                                <span>İl merkezi</span>
                                            </label>
                                            <label class="flex items-center gap-1.5 text-xs text-gray-700 mt-4">
                                                <input type="checkbox" name="isActive" value="true" checked="@(d.IsActive ? "checked" : null)" disabled="@(d.IsHome ? "disabled" : null)" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                                                <span>Aktif</span>
                                            </label>
                                        </div>
                                        @if (d.IsHome)
                                        {
                                            @* Ev ilçesinin slug'ı IsLocal türetmesinin çıpası: adı/ili değişirse
                                               o günden sonra yazılan her etkinlik "yerel değil" olur. Komut da
                                               reddediyor — buradaki kilit yalnız sebebini SÖYLEMEK için. *@
                                            <input type="hidden" name="isActive" value="true" />
                                            <p class="text-xs text-amber-600">Uygulamanın kendi ilçesi: adı, ili ve aktifliği değiştirilemez.</p>
                                        }
                                        else if (d.EventCount > 0)
                                        {
                                            <p class="text-xs text-amber-600">@d.EventCount etkinlik bu ilçede — pasife almak yeni seçimi engeller, mevcut etkinlikler korunur.</p>
                                        }
                                        <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

    @* ---------------- Mezarlıklar ---------------- *@
    <details class="bg-white rounded-lg border border-gray-200 shadow-sm" open="@Open("cemeteries")">
        <summary class="px-6 py-4 cursor-pointer flex items-center gap-3 hover:bg-gray-50 rounded-lg">
            <i class="fas fa-cross text-indigo-500 w-5"></i>
            <span class="font-medium text-gray-800">Mezarlıklar</span>
            <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full">@Model.Cemeteries.Count</span>
            <span class="text-xs text-gray-400 ml-auto">Vefat ilanı formunda seçilir</span>
        </summary>
        <div class="border-t border-gray-100 px-6 pb-6">
            <form asp-action="CemeteryCreate" method="post" class="flex flex-wrap items-end gap-3 py-4 border-b border-gray-100">
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Yeni Mezarlık Adı <span class="text-red-500">*</span></label>
                    <input name="name" required maxlength="150" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Adres</label>
                    <input name="address" maxlength="300" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <button type="submit" class="rounded-md bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Ekle</button>
            </form>
            <table class="w-full text-sm mt-2">
                <thead>
                    <tr class="text-left text-xs text-gray-500 uppercase">
                        <th class="py-2 pr-4">Ad</th>
                        <th class="py-2 pr-4">Adres</th>
                        <th class="py-2 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var c in Model.Cemeteries)
                    {
                        <tr>
                            <td class="py-2.5 pr-4 font-medium text-gray-900">@c.Name</td>
                            <td class="py-2.5 pr-4 text-gray-600">@(c.Address ?? "-")</td>
                            <td class="py-2.5 text-right">
                                <details class="relative inline-block text-left">
                                    <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                                    <form asp-action="CemeteryUpdate" method="post" class="absolute right-0 z-10 mt-2 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ad</label>
                                            <input name="name" required maxlength="150" value="@c.Name" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Adres</label>
                                            <input name="address" maxlength="300" value="@c.Address" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

    @* ---------------- Camiler ---------------- *@
    <details class="bg-white rounded-lg border border-gray-200 shadow-sm" open="@Open("mosques")">
        <summary class="px-6 py-4 cursor-pointer flex items-center gap-3 hover:bg-gray-50 rounded-lg">
            <i class="fas fa-mosque text-indigo-500 w-5"></i>
            <span class="font-medium text-gray-800">Camiler</span>
            <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full">@Model.Mosques.Count</span>
            <span class="text-xs text-gray-400 ml-auto">Vefat ilanı formunda (cenaze namazı) seçilir</span>
        </summary>
        <div class="border-t border-gray-100 px-6 pb-6">
            <form asp-action="MosqueCreate" method="post" class="flex flex-wrap items-end gap-3 py-4 border-b border-gray-100">
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Yeni Cami Adı <span class="text-red-500">*</span></label>
                    <input name="name" required maxlength="150" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Adres</label>
                    <input name="address" maxlength="300" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <button type="submit" class="rounded-md bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Ekle</button>
            </form>
            <table class="w-full text-sm mt-2">
                <thead>
                    <tr class="text-left text-xs text-gray-500 uppercase">
                        <th class="py-2 pr-4">Ad</th>
                        <th class="py-2 pr-4">Adres</th>
                        <th class="py-2 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var m in Model.Mosques)
                    {
                        <tr>
                            <td class="py-2.5 pr-4 font-medium text-gray-900">@m.Name</td>
                            <td class="py-2.5 pr-4 text-gray-600">@(m.Address ?? "-")</td>
                            <td class="py-2.5 text-right">
                                <details class="relative inline-block text-left">
                                    <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                                    <form asp-action="MosqueUpdate" method="post" class="absolute right-0 z-10 mt-2 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ad</label>
                                            <input name="name" required maxlength="150" value="@m.Name" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Adres</label>
                                            <input name="address" maxlength="300" value="@m.Address" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

    @* ---------------- Etkinlik kategorileri ---------------- *@
    <details class="bg-white rounded-lg border border-gray-200 shadow-sm" open="@Open("event-categories")">
        <summary class="px-6 py-4 cursor-pointer flex items-center gap-3 hover:bg-gray-50 rounded-lg">
            <i class="fas fa-calendar-alt text-indigo-500 w-5"></i>
            <span class="font-medium text-gray-800">Etkinlik Kategorileri</span>
            <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full">@Model.EventCategories.Count</span>
        </summary>
        <div class="border-t border-gray-100 px-6 pb-6">
            <form asp-action="EventCategoryCreate" method="post" class="flex flex-wrap items-end gap-3 py-4 border-b border-gray-100">
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Yeni Kategori Adı <span class="text-red-500">*</span></label>
                    <input name="name" required maxlength="100" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" placeholder="Örn: Konser" />
                </div>
                <button type="submit" class="rounded-md bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Ekle</button>
            </form>
            <table class="w-full text-sm mt-2">
                <thead>
                    <tr class="text-left text-xs text-gray-500 uppercase">
                        <th class="py-2 pr-4">Ad</th>
                        <th class="py-2 pr-4">Slug</th>
                        <th class="py-2 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var ec in Model.EventCategories)
                    {
                        <tr>
                            <td class="py-2.5 pr-4 font-medium text-gray-900">@ec.Name</td>
                            <td class="py-2.5 pr-4 text-gray-400 text-xs">@ec.Slug</td>
                            <td class="py-2.5 text-right">
                                <details class="relative inline-block text-left">
                                    <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                                    <form asp-action="EventCategoryUpdate" method="post" class="absolute right-0 z-10 mt-2 w-64 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                        <input type="hidden" name="id" value="@ec.Id" />
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ad <span class="text-gray-400 font-normal">(slug yeniden üretilir)</span></label>
                                            <input name="name" required maxlength="100" value="@ec.Name" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

    @* ---------------- Mekan kategorileri ---------------- *@
    <details class="bg-white rounded-lg border border-gray-200 shadow-sm" open="@Open("place-categories")">
        <summary class="px-6 py-4 cursor-pointer flex items-center gap-3 hover:bg-gray-50 rounded-lg">
            <i class="fas fa-map-marker-alt text-indigo-500 w-5"></i>
            <span class="font-medium text-gray-800">Mekan Kategorileri</span>
            <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full">@Model.PlaceCategories.Count</span>
        </summary>
        <div class="border-t border-gray-100 px-6 pb-6">
            <form asp-action="PlaceCategoryCreate" method="post" class="flex flex-wrap items-end gap-3 py-4 border-b border-gray-100">
                <div class="grow min-w-48">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Yeni Kategori Adı <span class="text-red-500">*</span></label>
                    <input name="name" required maxlength="100" class="block w-full rounded-md border-gray-300 text-sm py-2 px-3 border" placeholder="Örn: Restoran" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">İkon <span class="text-gray-400 font-normal">(Font Awesome adı)</span></label>
                    <input name="icon" maxlength="50" class="block w-40 rounded-md border-gray-300 text-sm py-2 px-3 border" placeholder="fa-utensils" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                    <input name="displayOrder" type="number" value="0" class="block w-20 rounded-md border-gray-300 text-sm py-2 px-3 border" />
                </div>
                <button type="submit" class="rounded-md bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Ekle</button>
            </form>
            <table class="w-full text-sm mt-2">
                <thead>
                    <tr class="text-left text-xs text-gray-500 uppercase">
                        <th class="py-2 pr-4">Ad</th>
                        <th class="py-2 pr-4">İkon</th>
                        <th class="py-2 pr-4">Sıra</th>
                        <th class="py-2 pr-4">Mekan</th>
                        <th class="py-2 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var pc in Model.PlaceCategories)
                    {
                        <tr>
                            <td class="py-2.5 pr-4">
                                <span class="font-medium text-gray-900">@pc.Name</span>
                                <span class="text-xs text-gray-400 ml-1">@pc.Slug</span>
                            </td>
                            <td class="py-2.5 pr-4 text-gray-600">
                                @if (!string.IsNullOrEmpty(pc.Icon))
                                {
                                    <i class="fas @pc.Icon mr-1 text-gray-400"></i>@pc.Icon
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="py-2.5 pr-4 text-gray-600">@pc.DisplayOrder</td>
                            <td class="py-2.5 pr-4 text-gray-600" title="Bu kategorideki mekan sayısı">@pc.PlaceCount</td>
                            <td class="py-2.5 text-right">
                                <details class="relative inline-block text-left">
                                    <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                                    <form asp-action="PlaceCategoryUpdate" method="post" class="absolute right-0 z-10 mt-2 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                        <input type="hidden" name="id" value="@pc.Id" />
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ad <span class="text-gray-400 font-normal">(slug yeniden üretilir)</span></label>
                                            <input name="name" required maxlength="100" value="@pc.Name" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <div class="grow">
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">İkon</label>
                                                <input name="icon" maxlength="50" value="@pc.Icon" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                                                <input name="displayOrder" type="number" value="@pc.DisplayOrder" class="block w-20 rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                            </div>
                                        </div>
                                        <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>

</div>
