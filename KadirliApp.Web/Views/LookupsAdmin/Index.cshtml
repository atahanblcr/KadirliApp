                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ad <span class="text-gray-400 font-normal">(slug yeniden üretilir)</span></label>
                                            <input name="name" required maxlength="100" value="@pc.Name" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                        </div>
