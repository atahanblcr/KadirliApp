@using KadirliApp.Application.Features.Events
@using KadirliApp.Application.Features.Lookups
@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.Events.Dtos.EventResponseDto>
@{
    ViewData["Title"] = "Etkinlik Yönetimi";

    // Faz 12.4 — konum süzgeci. Şeritteki etiketler EventLocationScopes.Label'dan gelir;
    // ham "nearby"/"local" ekrana basılmaz (Değişmez Kural #6).
    var districts = ViewBag.Districts as IReadOnlyList<DistrictAdminDto> ?? [];
    Guid? districtId = ViewBag.DistrictId;
    EventLocationScope locationScope = ViewBag.LocationScope ?? EventLocationScope.All;
    var districtFilter = new KadirliApp.Web.Models.DistrictSelectViewModel
    {
        Districts = districts,
        Name = "DistrictId",
        Selected = districtId,
        EmptyLabel = "Tüm ilçeler"
    };
    var scopeChips = new[]
    {
        EventLocationScope.All, EventLocationScope.Local,
        EventLocationScope.Province, EventLocationScope.Nearby
    };

    // Faz 11.18 — toplu işlem çubuğu ve satır kutuları tek yerden kurulur.
    var bulkController = "EventsAdmin";
    var bulkToolbar = KadirliApp.Web.Models.BulkToolbarViewModel.Moderation("EventsAdmin", "etkinlik");

    // Faz 11.18 — tıklanabilir sütun başlıkları etkin sıralamayı buradan okur.
    var currentSort = Context.Request.Query["sort"].ToString();
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Etkinlik Yönetimi</h2>
        <p class="text-sm text-gray-500 mt-1">Şehirdeki etkinlikleri görüntüleyin, onaylayın ve yönetin.</p>
    </div>
    <div class="flex items-center gap-2">
        <partial name="_ExportCsvButton" />
        <a asp-action="Calendar" class="text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
            <i class="fas fa-calendar-alt mr-2"></i> Takvim Görünümü
        </a>
        <a asp-action="Create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow">
            <i class="fas fa-plus mr-2"></i> Yeni Ekle
        </a>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm" data-bulk-scope>
    <div class="p-4 border-b border-gray-200 space-y-3">
        @* Faz 12.4: arama ve ilçe TEK formda — ayrı formlar olsaydı ilçeyi seçip arama
           yapmak süzgeci sıfırlardı (ve tersi). *@
        <form action="" method="get" class="flex flex-wrap items-end gap-3">
            @if (locationScope != EventLocationScope.All)
            {
                <input type="hidden" name="LocationScope" value="@EventLocationScopes.Value(locationScope)" />
            }
            <div class="relative w-full md:w-64">
                <label for="Search" class="block text-xs font-medium text-gray-600 mb-1">Ara</label>
                <div class="absolute inset-y-0 left-0 pl-3 pt-5 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
                <input id="Search" type="text" name="Search" placeholder="Başlık ile ara..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg w-full text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" value="@Context.Request.Query["Search"]">
            </div>
            <div class="w-full md:w-56">
                <label for="DistrictId" class="block text-xs font-medium text-gray-600 mb-1">İlçe</label>
                <partial name="_DistrictSelect" model="districtFilter" />
            </div>
            <button type="submit" class="rounded-lg bg-indigo-600 py-2 px-5 text-sm font-medium text-white shadow hover:bg-indigo-700">Filtrele</button>
            @if (!string.IsNullOrWhiteSpace(Context.Request.Query["Search"]) || districtId != null || locationScope != EventLocationScope.All)
            {
                <a asp-action="Index" class="py-2 px-4 text-sm text-gray-600 hover:text-gray-900">Temizle</a>
            }
        </form>

        @* Konum kapsamı şeridi — "Çevre iller" tanımının sahibi sunucu (EventLocationScopes). *@
        <div class="flex flex-wrap gap-2">
            @* 🐛 Bağlantılar `asp-route-*` ile ELLE sayılmaz: ilk yazımda `Search` ve
               `DistrictId` sayılmış, `sort` unutulmuştu → sıralı bir listede chip'e
               tıklamak sıralamayı **sessizce** varsayılana döndürüyordu. Kural artık
               `PanelQuery.With`'te: mevcut sorgu korunur, yalnız kapsam değişir. *@
            @foreach (var chip in scopeChips)
            {
                var active = chip == locationScope;
                <a href="@PanelQuery.With(Context.Request, "LocationScope", EventLocationScopes.Value(chip))"
                   class="px-3 py-1 rounded-full text-xs font-medium border transition-colors @(active ? "bg-indigo-600 text-white border-indigo-600" : "bg-white text-gray-600 border-gray-300 hover:bg-gray-50")">
                    @EventLocationScopes.Label(chip)
                </a>
            }
        </div>
    </div>

    @* Faz 11.18: toplu işlem — satır seçimi + toplu eylem. *@
    <partial name="_BulkToolbar" model="bulkToolbar" />
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <partial name="_BulkSelectAll" />
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Başlık", "title_asc", "title_desc", currentSort)' />
                    <th scope="col" class="px-6 py-3 font-medium">Kategori</th>
                    <partial name="_SortableHeader" model='new KadirliApp.Web.Models.SortableHeaderViewModel("Tarih / Saat", "date_asc", "date_desc", currentSort)' />
                    <th scope="col" class="px-6 py-3 font-medium">Mekan</th>
                    <th scope="col" class="px-6 py-3 font-medium">Konum</th>
                    <th scope="col" class="px-6 py-3 font-medium">Ücret</th>
                    <th scope="col" class="px-6 py-3 font-medium">Durum</th>
                    <th scope="col" class="px-6 py-3 text-right font-medium">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <partial name="_BulkRowCheckbox" model="KadirliApp.Web.Models.BulkRowViewModel.For(bulkController, item.Id)" />
                            <td class="px-6 py-4 font-medium text-gray-900">@item.Title</td>
                            <td class="px-6 py-4">@(item.CategoryName ?? "—")</td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span>@item.EventDate.ToString("dd.MM.yyyy")</span>
                                    <span class="text-xs text-gray-400">@item.EventTime.ToString(@"hh\:mm")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">@(item.VenueName ?? "—")</td>
                            @* Konum etiketi sunucudan hazır gelir (locationLabel) — panel kendi
                               biçimini yazsaydı mobille ayrışırdı, görünmez sözleşme #23'ün sınıfı. *@
                            <td class="px-6 py-4">
                                @if (item.LocationLabel is { Length: > 0 } label)
                                {
                                    <span class="inline-flex items-center gap-1 @(item.IsLocal ? "text-indigo-700" : "text-gray-600")">
                                        <i class="fas fa-location-dot text-xs"></i>@label
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.IsFree)
                                {
                                    <span class="text-green-600 font-medium">Ücretsiz</span>
                                }
                                else
                                {
                                    @PanelDisplay.TL(item.TicketPrice, "—")
                                }
                            </td>
                            <td class="px-6 py-4">
                                <partial name="_StatusBadge" model="PanelDisplay.Status(item.Status)" />
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 items-center">
                                    @if (item.Status != "approved")
                                    {
                                        <form asp-action="Approve" method="post" class="inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="text-green-600 hover:text-green-900" title="Onayla">
                                                <i class="fas fa-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (item.Status != "rejected")
                                    {
                                        <form asp-action="Reject" method="post" class="inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="text-yellow-600 hover:text-yellow-900" title="Reddet">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" method="post" class="inline" data-confirm="“@item.Title” etkinliğini silmek istediğinize emin misiniz?">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="text-red-600 hover:text-red-900" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="px-6 py-8 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-calendar-times text-4xl text-gray-300 mb-3"></i>
                                <p>Kayıt bulunamadı.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", PaginationViewModel.From(Model, "etkinlik"))
</div>
