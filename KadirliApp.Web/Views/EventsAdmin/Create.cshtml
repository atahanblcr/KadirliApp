@model KadirliApp.Application.Features.Events.Commands.CreateEventCommand
@{
    ViewData["Title"] = "Yeni Etkinlik Ekle";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Yeni Etkinlik Ekle</h2>
            <p class="text-sm text-gray-500 mt-1">Sisteme yeni bir etkinlik ekleyin (panelden eklenenler doğrudan onaylı yayınlanır).</p>
        </div>
        <div class="flex gap-2">
            <a asp-action="Calendar" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-300 bg-white shadow-sm">
                <i class="fas fa-calendar-alt mr-2"></i> Takvim
            </a>
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-300 bg-white shadow-sm">
                <i class="fas fa-arrow-left mr-2"></i> Geri Dön
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6 sm:p-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-6">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Title -->
                <div class="col-span-1 md:col-span-2">
                    <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-2">Etkinlik Başlığı <span class="text-red-500">*</span></label>
                    <input asp-for="Title" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Kadirli Yaz Festivali" required />
                    <span asp-validation-for="Title" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Category -->
                <div>
                    <label asp-for="CategoryId" class="block text-sm font-semibold text-gray-700 mb-2">Kategori <span class="text-red-500">*</span></label>
                    <select asp-for="CategoryId" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" required>
                        <option value="">-- Kategori Seçiniz --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Organizer -->
                <div>
                    <label asp-for="Organizer" class="block text-sm font-semibold text-gray-700 mb-2">Organizatör</label>
                    <input asp-for="Organizer" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Kadirli Belediyesi" />
                </div>

                <!-- Event Date -->
                <div>
                    <label asp-for="EventDate" class="block text-sm font-semibold text-gray-700 mb-2">Etkinlik Tarihi <span class="text-red-500">*</span></label>
                    <input asp-for="EventDate" type="date" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" required />
                    <span asp-validation-for="EventDate" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Event Time -->
                <div>
                    <label asp-for="EventTime" class="block text-sm font-semibold text-gray-700 mb-2">Etkinlik Saati <span class="text-red-500">*</span></label>
                    <input asp-for="EventTime" type="time" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" required />
                    <span asp-validation-for="EventTime" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Venue -->
                <div>
                    <label asp-for="VenueName" class="block text-sm font-semibold text-gray-700 mb-2">Mekan Adı</label>
                    <input asp-for="VenueName" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Örn: Belediye Kültür Merkezi" />
                </div>

                <!-- Address -->
                <div>
                    <label asp-for="Address" class="block text-sm font-semibold text-gray-700 mb-2">Adres</label>
                    <input asp-for="Address" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" />
                </div>

                <!-- IsFree -->
                <div>
                    <label class="flex items-center gap-3 mt-2">
                        <input asp-for="IsFree" type="checkbox" class="h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                        <span class="text-sm font-semibold text-gray-700">Ücretsiz Etkinlik</span>
                    </label>
                </div>

                <!-- Ticket Price -->
                <div>
                    <label asp-for="TicketPrice" class="block text-sm font-semibold text-gray-700 mb-2">Bilet Ücreti (₺)</label>
                    <input asp-for="TicketPrice" type="number" step="0.01" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="0.00" />
                </div>

                <!-- Description -->
                <div class="col-span-1 md:col-span-2">
                    <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">Açıklama <span class="text-red-500">*</span></label>
                    <textarea asp-for="Description" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors shadow-sm" placeholder="Etkinlik detayları..." required></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Cover Image -->
                <div class="col-span-1 md:col-span-2 border-t border-gray-200 pt-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Etkinlik Fotoğrafı <span class="text-gray-400 font-normal">(opsiyonel)</span></label>
                    <p class="text-xs text-gray-500 mb-3">Mobil uygulamada etkinlik kartının kapak görseli olarak kullanılır.</p>
                    <div class="flex items-start gap-4">
                        <label for="coverInput" class="flex flex-col items-center justify-center w-44 h-28 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors">
                            <i class="fas fa-camera text-gray-400 text-xl mb-1"></i>
                            <span class="text-xs text-gray-500">Fotoğraf Seç</span>
                            <input id="coverInput" name="CoverImage" type="file" accept="image/*" class="hidden" onchange="previewImage(this)">
                        </label>
                        <div id="imagePreviewWrap" class="hidden relative">
                            <img id="imagePreview" class="h-28 rounded-lg border border-gray-200 object-cover" alt="Önizleme">
                            <button type="button" onclick="clearImage()" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 text-xs hover:bg-red-600" title="Kaldır">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="col-span-1 md:col-span-2 border-t border-gray-200 pt-6">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700">Etkinlik Konumu <span class="text-gray-400 font-normal">(opsiyonel)</span></label>
                            <p class="text-xs text-gray-500 mt-1">Konum seçerseniz mobil uygulamada "Konuma Git" butonu görünür. Haritaya tıklayarak işaretleyin.</p>
                        </div>
                        <button type="button" id="clearLocationBtn" class="text-sm text-red-600 hover:underline"><i class="fas fa-times mr-1"></i>Temizle</button>
                    </div>
                    <div id="locationMap" class="w-full rounded-lg border border-gray-300" style="height: 300px;"></div>
                    <div class="grid grid-cols-2 gap-4 mt-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-500">Enlem</label>
                            <input asp-for="Latitude" id="latInput" type="text" readonly class="mt-1 bg-gray-50 w-full text-sm border-gray-300 rounded-md py-2 px-3 border text-gray-500" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-500">Boylam</label>
                            <input asp-for="Longitude" id="lngInput" type="text" readonly class="mt-1 bg-gray-50 w-full text-sm border-gray-300 rounded-md py-2 px-3 border text-gray-500" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-200 mt-6 flex justify-end">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-6 rounded-lg shadow-md transition-all flex items-center">
                    <i class="fas fa-save mr-2"></i> Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<partial name="_LocationPickerScripts" />
<script>
    initLocationPicker('locationMap', 'latInput', 'lngInput', 'clearLocationBtn');

    function previewImage(input) {
        var wrap = document.getElementById('imagePreviewWrap');
        var img = document.getElementById('imagePreview');
        if (input.files && input.files[0]) {
            img.src = URL.createObjectURL(input.files[0]);
            wrap.classList.remove('hidden');
        }
    }
    function clearImage() {
        document.getElementById('coverInput').value = '';
        document.getElementById('imagePreviewWrap').classList.add('hidden');
    }
</script>
