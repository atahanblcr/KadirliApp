@model List<KadirliApp.Application.Features.Events.Queries.EventCalendarItemDto>
@{
    int year = (int)ViewBag.Year;
    int month = (int)ViewBag.Month;
    var monthStart = new DateTime(year, month, 1);
    var monthNames = new[] { "", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    ViewData["Title"] = $"Etkinlik Takvimi — {monthNames[month]} {year}";

    // Pazartesi başlangıçlı grid: ayın ilk gününün haftadaki indexi
    int leadingBlanks = ((int)monthStart.DayOfWeek + 6) % 7;
    int daysInMonth = DateTime.DaysInMonth(year, month);
    var eventsByDay = Model
        .GroupBy(e => e.EventDate.Day)
        .ToDictionary(g => g.Key, g => g.ToList());

    var prev = monthStart.AddMonths(-1);
    var next = monthStart.AddMonths(1);
    var today = DateTime.Today;
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Etkinlik Takvimi</h2>
        <p class="text-sm text-gray-500 mt-1">Hangi gün hangi etkinlik var görün; boş bir güne tıklayarak o güne etkinlik ekleyin.</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="Index" class="text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg text-sm font-medium border border-gray-300 bg-white shadow-sm">
            <i class="fas fa-list mr-2"></i>Liste Görünümü
        </a>
        <a asp-action="Create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow">
            <i class="fas fa-plus mr-2"></i> Yeni Etkinlik
        </a>
    </div>
</div>

<div class="bg-white rounded-xl border border-gray-200 shadow-md overflow-hidden">
    <!-- Ay navigasyonu -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 bg-gray-50">
        <a asp-action="Calendar" asp-route-year="@prev.Year" asp-route-month="@prev.Month"
           class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-100" title="Önceki ay">
            <i class="fas fa-chevron-left"></i>
        </a>
        <div class="flex items-center gap-3">
            <h3 class="text-lg font-semibold text-gray-800">@monthNames[month] @year</h3>
            <a asp-action="Calendar" class="text-xs text-indigo-600 hover:underline">Bugüne dön</a>
        </div>
        <a asp-action="Calendar" asp-route-year="@next.Year" asp-route-month="@next.Month"
           class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-100" title="Sonraki ay">
            <i class="fas fa-chevron-right"></i>
        </a>
    </div>

    <!-- Gün başlıkları -->
    <div class="grid grid-cols-7 border-b border-gray-200 bg-gray-50 text-xs font-medium text-gray-500 uppercase">
        @foreach (var dayName in new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" })
        {
            <div class="px-2 py-2 text-center">@dayName</div>
        }
    </div>

    <!-- Takvim ızgarası -->
    <div class="grid grid-cols-7">
        @for (int i = 0; i < leadingBlanks; i++)
        {
            <div class="min-h-28 border-b border-r border-gray-100 bg-gray-50/50"></div>
        }
        @for (int day = 1; day <= daysInMonth; day++)
        {
            var date = new DateTime(year, month, day);
            var isToday = date == today;
            var dayEvents = eventsByDay.TryGetValue(day, out var list) ? list : null;

            <div class="relative min-h-28 border-b border-r border-gray-100 p-1.5 group hover:bg-indigo-50/40 transition-colors">
                <div class="flex items-center justify-between">
                    <span class="@(isToday ? "w-6 h-6 flex items-center justify-center rounded-full bg-indigo-600 text-white text-xs font-bold" : "text-xs font-medium text-gray-500 px-1")">@day</span>
                    <a asp-action="Create" asp-route-date="@date.ToString("yyyy-MM-dd")"
                       class="opacity-0 group-hover:opacity-100 transition-opacity w-5 h-5 flex items-center justify-center rounded bg-indigo-600 text-white text-[10px] hover:bg-indigo-700"
                       title="@date.ToString("dd.MM.yyyy") gününe etkinlik ekle">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>
                <div class="mt-1 space-y-1">
                    @if (dayEvents != null)
                    {
                        foreach (var ev in dayEvents.Take(3))
                        {
                            var chipClass = ev.Status == "approved"
                                ? "bg-indigo-100 text-indigo-800 border-indigo-200"
                                : ev.Status == "pending"
                                    ? "bg-amber-100 text-amber-800 border-amber-200"
                                    : "bg-gray-100 text-gray-600 border-gray-200";
                            <a asp-action="Edit" asp-route-id="@ev.Id"
                               class="block text-[11px] leading-tight px-1.5 py-1 rounded border @chipClass truncate hover:opacity-80"
                               title="@ev.Title — @ev.EventTime.ToString(@"hh\:mm") @(ev.VenueName ?? "")">
                                <span class="font-semibold">@ev.EventTime.ToString(@"hh\:mm")</span> @ev.Title
                            </a>
                        }
                        @if (dayEvents.Count > 3)
                        {
                            <div class="text-[10px] text-gray-400 px-1">+@(dayEvents.Count - 3) daha</div>
                        }
                    }
                </div>
            </div>
        }
        @{
            int totalCells = leadingBlanks + daysInMonth;
            int trailing = (7 - totalCells % 7) % 7;
        }
        @for (int i = 0; i < trailing; i++)
        {
            <div class="min-h-28 border-b border-r border-gray-100 bg-gray-50/50"></div>
        }
    </div>

    <!-- Lejant -->
    <div class="flex items-center gap-4 px-6 py-3 bg-gray-50 border-t border-gray-200 text-xs text-gray-500">
        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-indigo-100 border border-indigo-200"></span> Onaylı</span>
        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-100 border border-amber-200"></span> Onay Bekliyor</span>
        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-gray-100 border border-gray-200"></span> Diğer</span>
        <span class="ml-auto text-gray-400"><i class="fas fa-info-circle mr-1"></i>Bir günün üzerine gelip <b>+</b> ile o güne etkinlik ekleyin, etkinliğe tıklayıp düzenleyin.</span>
    </div>
</div>
