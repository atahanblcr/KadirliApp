@model IReadOnlyList<KadirliApp.Application.Features.Ads.Queries.CategoryPropertyAdminDto>
@{
    var category = (KadirliApp.Application.Features.Ads.Queries.AdCategoryAdminDto)ViewBag.Category;
    ViewData["Title"] = $"{category.Name} — Özellikler";
    var typeLabels = new Dictionary<string, string>
    {
        ["Text"] = "Metin", ["Number"] = "Sayı", ["Boolean"] = "Evet/Hayır",
        ["Select"] = "Tek Seçim", ["MultiSelect"] = "Çoklu Seçim"
    };
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">@category.Name — Kategori Özellikleri</h2>
        <p class="text-sm text-gray-500 mt-1">Bu kategoride ilan verirken doldurulan form alanları (Örn: Yakıt Tipi, Model Yılı). Mobil, bu listeyi <code>/v1/ads/categories/{id}/properties</code> ucundan okur.</p>
    </div>
    <a asp-action="Index" class="text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
        <i class="fas fa-sitemap mr-2"></i> Kategoriler
    </a>
</div>

@* Yeni özellik ekleme (BusinessesAdmin hızlı-kategori <details> deseni) *@
<details class="bg-white rounded-lg border border-gray-200 shadow-sm mb-4">
    <summary class="px-6 py-4 cursor-pointer text-sm font-medium text-indigo-700 hover:bg-gray-50 rounded-lg">
        <i class="fas fa-plus mr-2"></i>Yeni Özellik Ekle
    </summary>
    <form asp-action="PropertyCreate" method="post" class="px-6 pb-6 pt-2 grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-gray-100">
        <input type="hidden" name="categoryId" value="@category.Id" />
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Özellik Adı <span class="text-red-500">*</span></label>
            <input name="propertyName" required maxlength="100" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" placeholder="Örn: Yakıt Tipi" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Tip <span class="text-red-500">*</span> <span class="text-gray-400 font-normal">(sonradan değiştirilemez)</span></label>
            <select name="propertyType" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border"
                    onchange="document.getElementById('newPropOptions').style.display = (this.value === 'Select' || this.value === 'MultiSelect') ? '' : 'none';">
                @foreach (var t in typeLabels)
                {
                    <option value="@t.Key">@t.Value (@t.Key)</option>
                }
            </select>
        </div>
        <div id="newPropOptions" class="md:col-span-2" style="display:none">
            <label class="block text-sm font-semibold text-gray-700 mb-1">Seçenekler <span class="text-gray-400 font-normal">(virgülle ayırın — Select/MultiSelect için zorunlu)</span></label>
            <input name="options" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" placeholder="Benzin, Dizel, LPG, Elektrik" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Varsayılan Değer</label>
            <input name="defaultValue" maxlength="200" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" />
        </div>
        <div class="flex items-end gap-6">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Sıra</label>
                <input name="displayOrder" type="number" value="0" class="block w-24 rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" />
            </div>
            <label class="flex items-center gap-2 text-sm text-gray-700 pb-2.5">
                <input type="checkbox" name="isRequired" value="true" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                <span>Zorunlu alan</span>
            </label>
            <button type="submit" class="ml-auto rounded-md bg-indigo-600 py-2 px-6 text-sm font-medium text-white shadow hover:bg-indigo-700 mb-0.5">Ekle</button>
        </div>
    </form>
</details>

<div class="space-y-4">
    @if (Model.Any())
    {
        foreach (var p in Model)
        {
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-5">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-gray-900">@p.PropertyName</span>
                            <span class="bg-indigo-100 text-indigo-700 text-xs font-medium px-2 py-0.5 rounded">@(typeLabels.TryGetValue(p.PropertyType, out var tl) ? tl : p.PropertyType)</span>
                            @if (p.IsRequired)
                            {
                                <span class="bg-red-100 text-red-700 text-xs font-medium px-2 py-0.5 rounded">Zorunlu</span>
                            }
                        </div>
                        <div class="text-xs text-gray-400 mt-1">
                            Sıra: @p.DisplayOrder
                            @if (!string.IsNullOrEmpty(p.DefaultValue))
                            {
                                <span> · Varsayılan: @p.DefaultValue</span>
                            }
                            <span> · @p.UsageCount ilanda değer girilmiş</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <details class="relative">
                            <summary class="cursor-pointer text-indigo-600 hover:text-indigo-800 text-sm list-none"><i class="fas fa-edit mr-1"></i>Düzenle</summary>
                            <form asp-action="PropertyUpdate" method="post" class="absolute right-0 z-10 mt-2 w-72 bg-white border border-gray-200 rounded-lg shadow-lg p-4 space-y-3">
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="hidden" name="categoryId" value="@category.Id" />
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Ad</label>
                                    <input name="propertyName" required maxlength="100" value="@p.PropertyName" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Varsayılan Değer</label>
                                    <input name="defaultValue" maxlength="200" value="@p.DefaultValue" class="block w-full rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                </div>
                                <div class="flex items-center gap-4">
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-600 mb-1">Sıra</label>
                                        <input name="displayOrder" type="number" value="@p.DisplayOrder" class="block w-20 rounded-md border-gray-300 text-sm py-1.5 px-2 border" />
                                    </div>
                                    <label class="flex items-center gap-1.5 text-xs text-gray-700 mt-4">
                                        <input type="checkbox" name="isRequired" value="true" checked="@(p.IsRequired ? "checked" : null)" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                                        <span>Zorunlu</span>
                                    </label>
                                </div>
                                <button type="submit" class="w-full rounded-md bg-indigo-600 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">Kaydet</button>
                            </form>
                        </details>
                        <form asp-action="PropertyDelete" method="post" class="inline"
                              data-confirm="Bu özelliği silmek istediğinize emin misiniz? Değer girilmiş ilan varsa silinemez.">
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="hidden" name="categoryId" value="@category.Id" />
                            <button type="submit" class="text-red-600 hover:text-red-800 text-sm"><i class="fas fa-trash-alt mr-1"></i>Sil</button>
                        </form>
                    </div>
                </div>

                @if (p.PropertyType is "Select" or "MultiSelect")
                {
                    <div class="mt-4 pt-4 border-t border-gray-100">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-xs font-semibold text-gray-500 uppercase">Seçenekler:</span>
                            @foreach (var o in p.Options)
                            {
                                <span class="inline-flex items-center gap-1 bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">
                                    @o.OptionValue
                                    <form asp-action="OptionDelete" method="post" class="inline"
                                          data-confirm="@o.OptionValue seçeneğini silmek istediğinize emin misiniz?">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="categoryId" value="@category.Id" />
                                        <button type="submit" class="text-gray-400 hover:text-red-600 leading-none" title="Seçeneği sil">&times;</button>
                                    </form>
                                </span>
                            }
                            <form asp-action="OptionCreate" method="post" class="inline-flex items-center gap-1">
                                <input type="hidden" name="propertyId" value="@p.Id" />
                                <input type="hidden" name="categoryId" value="@category.Id" />
                                <input type="hidden" name="displayOrder" value="@(p.Options.Count + 1)" />
                                <input name="optionValue" required maxlength="200" placeholder="Yeni seçenek"
                                       class="w-32 rounded-md border-gray-300 text-xs py-1 px-2 border" />
                                <button type="submit" class="text-indigo-600 hover:text-indigo-800 text-xs font-medium">+ Ekle</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm px-6 py-10 text-center text-gray-500">
            <i class="fas fa-list-ul text-4xl text-gray-300 mb-3"></i>
            <p>Bu kategoride henüz özellik tanımı yok.</p>
            <p class="text-xs text-gray-400 mt-1">Özellik tanımlanmazsa mobil ilan formunda yalnız standart alanlar (başlık, açıklama, fiyat...) görünür.</p>
        </div>
    }
</div>
