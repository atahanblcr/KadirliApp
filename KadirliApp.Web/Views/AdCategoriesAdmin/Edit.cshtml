@model KadirliApp.Application.Features.Ads.Queries.AdCategoryAdminDto
@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="p-6 max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-gray-800">Kategori Düzenle</h1>
            @if (Model.ParentName != null)
            {
                <p class="text-sm text-gray-500 mt-1">Üst kategori: <span class="font-medium">@Model.ParentName</span> (taşıma desteklenmez)</p>
            }
        </div>
        <a asp-action="Index" class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 shadow-sm">
            Geri Dön
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="p-8">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Kategori Adı <span class="text-red-500">*</span></label>
                    <input name="name" required minlength="2" maxlength="100" value="@Model.Name"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" />
                    <p class="text-xs text-gray-400 mt-1">Mevcut slug: <code>@Model.Slug</code> — ad değişirse slug yeniden üretilir.</p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">İkon <span class="text-gray-400 font-normal">(Font Awesome)</span></label>
                        <input name="icon" maxlength="50" value="@Model.Icon" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" placeholder="fas fa-car" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Sıra</label>
                        <input name="displayOrder" type="number" value="@Model.DisplayOrder" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" />
                    </div>
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" name="isActive" value="true" checked="@(Model.IsActive ? "checked" : null)" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                    <span>Aktif (mobilde görünür)</span>
                </label>
                @if (Model.AdCount > 0)
                {
                    <p class="text-xs text-amber-600"><i class="fas fa-info-circle mr-1"></i>Bu kategoride @Model.AdCount ilan var — pasife almak yeni ilan verilmesini engeller, mevcut ilanları silmez.</p>
                }

                <div class="pt-2 flex justify-end">
                    <button type="submit" class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-6 text-sm font-medium text-white shadow-md hover:bg-indigo-700">
                        Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
