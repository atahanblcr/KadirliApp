@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.Deaths.Dtos.DeathNoticeResponseDto>
@{
    ViewData["Title"] = "Vefat İlanları Yönetimi";
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Vefat İlanları Yönetimi</h2>
        <p class="text-sm text-gray-500 mt-1">Sistemdeki tüm vefat ilanlarını görüntüleyin ve yönetin.</p>
    </div>
    <div>
        <a asp-action="Create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-md">
            <i class="fas fa-plus mr-2"></i> Yeni Ekle
        </a>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
    <div class="p-4 border-b border-gray-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Search -->
        <div class="relative w-full md:w-64">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fas fa-search text-gray-400"></i>
            </div>
            <form action="" method="get">
                <input type="text" name="Search" placeholder="İsim ile ara..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg w-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" value="@Context.Request.Query["Search"]">
            </form>
        </div>
        
        <!-- Filters -->
        <div class="flex items-center gap-2">
            <button class="px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 flex items-center">
                <i class="fas fa-filter mr-2"></i> Filtrele
            </button>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                <tr>
                    <th scope="col" class="px-6 py-3 font-medium">Merhum / Merhume</th>
                    <th scope="col" class="px-6 py-3 font-medium">Cami / Mezarlık</th>
                    <th scope="col" class="px-6 py-3 font-medium">Cenaze Tarihi</th>
                    <th scope="col" class="px-6 py-3 font-medium">Durum</th>
                    <th scope="col" class="px-6 py-3 text-right font-medium">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">
                                <div class="flex items-center gap-2">
                                    @item.DeceasedName
                                    @if (item.HasCondolenceLocation)
                                    {
                                        <i class="fas fa-map-marker-alt text-indigo-400" title="Taziye konumu ekli"></i>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-xs">
                                <div class="flex flex-col">
                                    <span>@(item.MosqueName ?? "-")</span>
                                    <span class="text-gray-400">@(item.CemeteryName ?? "-")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span>@item.FuneralDate.ToString("dd.MM.yyyy")</span>
                                    <span class="text-xs text-gray-400">@item.FuneralTime.ToString(@"hh\:mm")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Status == "approved")
                                {
                                    <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">Aktif</span>
                                }
                                else if (item.Status == "pending")
                                {
                                    <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded">Bekliyor</span>
                                }
                                else
                                {
                                    <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded">@item.Status</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (item.Status != "approved")
                                {
                                    <form asp-action="Approve" method="post" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="text-green-600 hover:text-green-900 mr-3" title="Onayla">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 mr-3" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('İlanı silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-900" title="Sil">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fas fa-inbox text-4xl text-gray-300 mb-3"></i>
                                <p>Kayıt bulunamadı.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-4 border-t border-gray-200 flex items-center justify-between">
            <span class="text-sm text-gray-500">
                Toplam <span class="font-medium text-gray-900">@Model.TotalCount</span> kayıttan 
                <span class="font-medium text-gray-900">@((Model.CurrentPage - 1) * Model.PageSize + 1)</span> - 
                <span class="font-medium text-gray-900">@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))</span> arası gösteriliyor
            </span>
            <nav aria-label="Sayfalama">
                <ul class="inline-flex items-center -space-x-px text-sm">
                    <li>
                        <a href="?Search=@Context.Request.Query["Search"]&Page=@(Model.CurrentPage - 1)" 
                           class="flex items-center justify-center px-3 h-8 ml-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100 hover:text-gray-700 @(Model.CurrentPage <= 1 ? "pointer-events-none opacity-50" : "")">
                            <span class="sr-only">Önceki</span>
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li>
                            <a href="?Search=@Context.Request.Query["Search"]&Page=@i" 
                               class="flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 
                               @(i == Model.CurrentPage ? "text-blue-600 bg-blue-50 hover:bg-blue-100 hover:text-blue-700" : "text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700")">
                                @i
                            </a>
                        </li>
                    }

                    <li>
                        <a href="?Search=@Context.Request.Query["Search"]&Page=@(Model.CurrentPage + 1)" 
                           class="flex items-center justify-center px-3 h-8 leading-tight text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100 hover:text-gray-700 @(Model.CurrentPage >= Model.TotalPages ? "pointer-events-none opacity-50" : "")">
                            <span class="sr-only">Sonraki</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
