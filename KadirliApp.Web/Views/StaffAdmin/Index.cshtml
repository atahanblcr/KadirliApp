@model KadirliApp.Application.Common.Models.PagedResult<KadirliApp.Application.Features.Staff.DTOs.StaffDto>
@{
    ViewData["Title"] = "Personel Yönetimi";
    var roleLabels = new Dictionary<string, string>
    {
        ["moderator"] = "Moderatör", ["admin"] = "Admin", ["super_admin"] = "Süper Admin"
    };
}

<div class="mb-6 flex justify-between items-center flex-wrap gap-3">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">Personel Yönetimi</h2>
        <p class="text-sm text-gray-500 mt-1">Panel personeli (moderatör/admin) ve modül izinleri. İzin matrisi yalnız moderatörlere uygulanır.</p>
    </div>
    <div class="flex items-center gap-3">
        <form method="get" class="flex items-center gap-2">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Telefon, kullanıcı adı, e-posta..."
                   class="rounded-lg border border-gray-300 py-2 px-4 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-gray-700 rounded-lg shadow hover:bg-gray-800">Ara</button>
        </form>
        <a asp-action="Create" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg shadow hover:bg-indigo-700">
            <i class="fas fa-user-plus mr-2"></i>Yeni Personel
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 shadow-sm" role="alert">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 shadow-sm" role="alert">@TempData["Error"]</div>
}

<div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-x-auto">
    <table class="min-w-full text-sm">
        <thead>
            <tr class="text-left text-xs text-gray-500 uppercase bg-gray-50 border-b border-gray-200">
                <th class="px-5 py-3">Personel</th>
                <th class="px-5 py-3">Rol</th>
                <th class="px-5 py-3">İzinli Modüller</th>
                <th class="px-5 py-3">Durum</th>
                <th class="px-5 py-3">Kayıt</th>
                <th class="px-5 py-3 text-right">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var s in Model.Items)
            {
                var isSuperAdmin = s.Role == "super_admin";
                <tr class="hover:bg-gray-50">
                    <td class="px-5 py-4">
                        <p class="font-semibold text-gray-900">@(string.IsNullOrEmpty(s.Username) ? "—" : s.Username)</p>
                        <p class="text-gray-500 text-xs">@s.Phone@(string.IsNullOrEmpty(s.Email) ? "" : $" · {s.Email}")</p>
                    </td>
                    <td class="px-5 py-4">
                        @if (isSuperAdmin)
                        {
                            <span class="bg-purple-100 text-purple-700 text-xs font-medium px-2 py-0.5 rounded">Süper Admin</span>
                        }
                        else if (s.Role == "admin")
                        {
                            <span class="bg-blue-100 text-blue-700 text-xs font-medium px-2 py-0.5 rounded">Admin</span>
                        }
                        else
                        {
                            <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-0.5 rounded">@(roleLabels.TryGetValue(s.Role, out var rl) ? rl : s.Role)</span>
                        }
                    </td>
                    <td class="px-5 py-4">
                        @if (s.Role == "moderator")
                        {
                            if (s.Permissions.Any())
                            {
                                <div class="flex flex-wrap gap-1 max-w-64">
                                    @foreach (var p in s.Permissions)
                                    {
                                        <span class="bg-indigo-50 text-indigo-700 text-xs px-1.5 py-0.5 rounded" title="@($"{(p.CanRead ? "okuma " : "")}{(p.CanCreate ? "ekleme " : "")}{(p.CanUpdate ? "güncelleme " : "")}{(p.CanDelete ? "silme " : "")}{(p.CanApprove ? "onay" : "")}".Trim())">@p.Module</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-amber-600" title="İzin tanımlanmadan moderatör Admin API'de hiçbir modüle erişemez">İzin yok!</span>
                            }
                        }
                        else
                        {
                            <span class="text-xs text-gray-400">Tüm modüller</span>
                        }
                    </td>
                    <td class="px-5 py-4">
                        @if (s.IsActive)
                        {
                            <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded">Aktif</span>
                        }
                        else
                        {
                            <span class="bg-gray-200 text-gray-600 text-xs font-medium px-2 py-0.5 rounded">Pasif</span>
                        }
                    </td>
                    <td class="px-5 py-4 text-gray-500 text-xs">@s.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td class="px-5 py-4 text-right">
                        @if (!isSuperAdmin)
                        {
                            <div class="flex justify-end gap-3 items-center">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="text-indigo-600 hover:text-indigo-800" title="Düzenle ve izinler"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" method="post" class="inline"
                                      onsubmit="return confirm('@(s.Username ?? s.Phone) personelini silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-800" title="Sil"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <span class="text-xs text-gray-400" title="super_admin panelden değiştirilemez">Korumalı</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Items.Any())
    {
        <div class="px-5 py-10 text-center text-gray-500">
            <i class="fas fa-user-shield text-4xl text-gray-300 mb-3"></i>
            <p>Kayıtlı personel bulunamadı.</p>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
        <span>Toplam @Model.TotalCount personel — sayfa @Model.CurrentPage/@Model.TotalPages</span>
        <div class="flex gap-2">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@ViewBag.Search"
                   class="px-3 py-1.5 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">← Önceki</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@ViewBag.Search"
                   class="px-3 py-1.5 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Sonraki →</a>
            }
        </div>
    </div>
}
