@model KadirliApp.Application.Features.Staff.DTOs.StaffDto
@{
    ViewData["Title"] = $"Personel — {Model.Username ?? Model.Phone}";
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-semibold text-gray-800">@(Model.Username ?? Model.Phone)</h2>
        <p class="text-sm text-gray-500 mt-1">@Model.Phone · kayıt @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
    </div>
    <a asp-action="Index" class="text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
        <i class="fas fa-arrow-left mr-2"></i> Personel Listesi
    </a>
</div>

<div class="space-y-4">
    @* Bilgiler *@
    <form asp-action="Edit" method="post" class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-4"><i class="fas fa-id-card mr-2 text-indigo-500"></i>Bilgiler</h3>
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Telefon <span class="text-gray-400 font-normal">(değiştirilemez)</span></label>
                <input value="@Model.Phone" disabled class="block w-full rounded-md border-gray-200 bg-gray-50 text-gray-500 sm:text-sm py-2 px-3 border" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Kullanıcı Adı</label>
                <input name="username" maxlength="30" value="@Model.Username" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">E-posta</label>
                <input name="email" type="email" maxlength="100" value="@Model.Email" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Rol</label>
                <select name="role" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm py-2 px-3 border">
                    <option value="moderator" selected="@(Model.Role == "moderator" ? "selected" : null)">Moderatör (izin matrisine tabi)</option>
                    <option value="admin" selected="@(Model.Role == "admin" ? "selected" : null)">Admin (tüm modüllere erişir)</option>
                </select>
            </div>
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input type="checkbox" name="isActive" value="true" checked="@(Model.IsActive ? "checked" : null)" class="h-4 w-4 text-indigo-600 border-gray-300 rounded" />
                <span>Hesap aktif</span>
            </label>
        </div>
        <div class="flex justify-end mt-4">
            <button type="submit" class="rounded-md bg-indigo-600 py-2 px-6 text-sm font-medium text-white shadow hover:bg-indigo-700">Bilgileri Kaydet</button>
        </div>
    </form>

    @* İzin matrisi — ayrı form: SetStaffPermissionsCommand mevcut satırları komple değiştirir *@
    <form asp-action="Permissions" method="post" class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-4"><i class="fas fa-shield-alt mr-2 text-indigo-500"></i>İzin Matrisi</h3>
        <input type="hidden" name="id" value="@Model.Id" />
        <partial name="_PermissionMatrix" model="@((IReadOnlyList<KadirliApp.Application.Features.Staff.DTOs.StaffPermissionDto>)Model.Permissions)" />
        <div class="flex justify-end mt-4">
            <button type="submit" class="rounded-md bg-indigo-600 py-2 px-6 text-sm font-medium text-white shadow hover:bg-indigo-700">İzinleri Kaydet</button>
        </div>
    </form>

    @* Şifre sıfırlama *@
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-1"><i class="fas fa-key mr-2 text-amber-500"></i>Şifre Sıfırlama</h3>
        <p class="text-xs text-gray-400 mb-4">Yeni şifre personele sizin tarafınızdan iletilmelidir — sistemde görüntülenemez ve loglanmaz.</p>
        <form asp-action="ResetPassword" method="post" class="flex items-end gap-3 flex-wrap"
              data-confirm="Personelin şifresini sıfırlamak istediğinize emin misiniz?">
            <input type="hidden" name="id" value="@Model.Id" />
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Yeni Şifre <span class="text-gray-400 font-normal">(en az 6 karakter)</span></label>
                <input name="newPassword" type="password" required minlength="6" class="block w-64 rounded-md border-gray-300 text-sm py-2 px-3 border" />
            </div>
            <button type="submit" class="rounded-md bg-amber-500 py-2 px-6 text-sm font-medium text-white shadow hover:bg-amber-600">Sıfırla</button>
        </form>
    </div>
</div>
