{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/web-.ndjson",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "KadirliApp.Web" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kadirliapp;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=10",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "kadirliapp",
    "Audience": "kadirliapp",
    "AccessSecret": "super_secret_key_which_is_at_least_32_characters_long_for_hmac_sha256",
    "RefreshSecret": "super_secret_refresh_key_which_is_at_least_32_characters_long",
    "AccessExpiresDays": 30,
    "RefreshExpiresDays": 90
  },
  "Otp": {
    "DevMode": true,
    "TtlSeconds": 300,
    "MaxAttempts": 3,
    "RateLimitPerHour": 10
  },
  "Sms": {
    "Provider": "Dev"
  },
  "Email": {
    "Provider": "Dev"
  },
  // Faz 12.2 — panelin giriş denemesi kaydı da aynı eşikleri kullanır.
  // ⚠️ Api/appsettings.json'daki değerlerle AYNI kalmalı: ayrışırlarsa aynı hesabın
  // panel girişi ile mobil girişi farklı eşiklerde şüpheli sayılır ve sebep hiçbir
  // yerde görünmez (görünmez sözleşme #23 sınıfı).
  "Security": {
    "Suspicion": {
      "WindowMinutes": 15,
      "AccountFailureThreshold": 5,
      "DistinctAccountsFromIpThreshold": 3,
      "IpFailureThreshold": 20,
      "JustAfterLockoutMinutes": 5
    }
  },
  // Faz 12.2 — Api ile AYNI ayarlar (bkz. ForwardedHeadersSetup).
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Fcm": {
    "Provider": "None",
    "ServiceAccountKeyPath": ""
  },
  "RateLimiting": {
    "PanelLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://panel.kadirli.app"
    ]
  },
  "FileStorage": {
    "UploadDirectory": "../uploads",
    "BaseUrl": ""
  }
}
