# uploads/ ARTIK TAKİP EDİLMİYOR (5 Ağu 2026). Eski not "panel incelemesi için örnek
# görseller repoda" diyordu ama repoya giren şey örnek değil TEST ARTIĞIydı: aynı 5 test
# görseli (a/b/contract/gercek/ilanda.png) onlarca kez, her biri yeni GUID'le.
# Bu ikinci tekrardı — 4085a96 (11.15c) ilk 39 artığı sildi ama buraya kapı koymadı,
# a165a62'deki `git add -A` 35 yenisini geri doldurdu. Kapı olmadan silmek işe yaramıyor.
# Klasörü LocalFileStorageService kendi oluşturuyor; repoda durmasına gerek yok.
uploads/

# ---- Yerel sırlar (isteğe bağlı: gerçek sırlar buraya konursa) ----
appsettings.*.Local.json
*.local.json

# --- Gizli anahtarlar (ASLA commit edilmez) ---
# Firebase service-account JSON'u özel anahtar taşır; sızarsa proje adına
# push gönderilebilir. Yer tutucu ve nasıl edinileceği: secrets/README.md
secrets/*
!secrets/README.md

# Firebase istemci yapılandırmaları (API anahtarı + proje kimliği taşır)
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# Android yayın imzalama (Faz 11.16) — anahtar deposu ve parolaları.
# ⚠️ Bu anahtar kaybolursa uygulama Play Store'da BİR DAHA güncellenemez;
# sızarsa başkası sizin uygulamanız adına güncelleme yayınlayabilir.
# Örnek dosya ve üretme adımları: mobile/android/key.properties.example
mobile/android/key.properties
*.jks
*.keystore

# Faz 12.21a — üretim yığınının ortam dosyası.
# 🔴 Buradaki her satır bir SIRDIR (JWT anahtarı, DB parolası, Hangfire parolası, Seq API
# key). Depo herkese açık ve 11.18'de bir parola tam olarak böyle sızdı. Şablon
# `.env.prod.example` commit edilir, doldurulmuş hâli ASLA.
.env
.env.*
!.env.prod.example
