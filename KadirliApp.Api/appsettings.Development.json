{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Faz 11.13 hazırlığı: FCM push geliştirme ortamında açık.
  // Anahtar dosyası repoda DEĞİL (secrets/ .gitignore'da) — nasıl edinileceği
  // secrets/README.md'de. Yol KadirliApp.Api/ dizinine göre çözülür
  // (FileStorage:UploadDirectory ile aynı kural).
  // Dosya yoksa uygulama ÇÖKMEZ: FcmPushService uyarı loglayıp no-op'a düşer.
  "Fcm": {
    "Provider": "Firebase",
    "ServiceAccountKeyPath": "../secrets/firebase-service-account.json"
  }
}
