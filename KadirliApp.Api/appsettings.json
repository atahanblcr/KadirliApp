{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.ndjson",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "KadirliApp.Api" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kadirliapp;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=10",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "kadirliapp",
    "Audience": "kadirliapp",
    "AccessSecret": "super_secret_key_which_is_at_least_32_characters_long_for_hmac_sha256",
    "RefreshSecret": "super_secret_refresh_key_which_is_at_least_32_characters_long",
    "AccessExpiresDays": 1,
    "RefreshExpiresDays": 90,
    "TempTokenMinutes": 30
  },
  "Otp": {
    "DevMode": true,
    "TtlSeconds": 300,
    "MaxAttempts": 3,
    "RateLimitPerHour": 10
  },
  "Sms": {
    "Provider": "Dev",
    "Netgsm": {
      "UserCode": "",
      "Password": "",
      "MsgHeader": ""
    }
  },
  "Email": {
    "Provider": "Dev",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "KadirliApp"
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "PublicWrite": {
      "PermitLimit": 15,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://panel.kadirli.app"
    ]
  },
  "Files": {
    "Storage": "Local",
    "BasePath": "uploads",
    "PublicBaseUrl": "/uploads"
  },
  "FileStorage": {
    "UploadDirectory": "../uploads"
  }
}
