{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.ndjson",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "KadirliApp.Api" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kadirliapp;Username=postgres;Password=postgres;Include Error Detail=true;Maximum Pool Size=100;Minimum Pool Size=10",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "kadirliapp",
    "Audience": "kadirliapp",
    "AccessSecret": "super_secret_key_which_is_at_least_32_characters_long_for_hmac_sha256",
    "RefreshSecret": "super_secret_refresh_key_which_is_at_least_32_characters_long",
    "AccessExpiresDays": 1,
    "RefreshExpiresDays": 90,
    "TempTokenMinutes": 30
  },
  "Otp": {
    "DevMode": true,
    "TtlSeconds": 300,
    "MaxAttempts": 3,
    "RateLimitPerHour": 10
  },
  "Sms": {
    "Provider": "Dev",
    "Netgsm": {
      "UserCode": "",
      "Password": "",
      "MsgHeader": ""
    }
  },
  "Email": {
    // "Dev" → log'a yazar. "Smtp" → gerçek gönderim (SmtpEmailService).
    // ⚠️ Kimlik bilgileri BURAYA YAZILMAZ — ortam değişkeni ya da secrets/ (depo herkese açık).
    "Provider": "Dev",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "KadirliApp",
      "EnableSsl": true,
      "TimeoutSeconds": 20
    }
  },
  // Faz 12.2 — şüpheli giriş gözlemi.
  "Security": {
    // Uyarı e-postası açık. ⚠️ Production'da Email:Provider=Dev ile birlikte olamaz:
    // ProductionReadinessGuard uygulamayı açtırmaz (uyarılar sessizce kimseye gitmezdi).
    "AlertEmailEnabled": true,
    // Uyarı e-postasındaki "panelde görüntüle" bağlantısının kökü. Boşsa bağlantı basılmaz.
    "PanelBaseUrl": "",
    // Eşikler. ⚠️ Bölüm SİLİNİRSE kurallar KAPANMAZ — varsayılanlar koda yazılı
    // (SuspicionThresholds). "Bayrakla kapalı yol = hiç test edilmemiş yol".
    "Suspicion": {
      "WindowMinutes": 15,
      // 🔴 PanelLockoutPolicy.MaxFailedAttempts ile AYNI olmak zorunda: ayrışırsa hesap
      // kilitlenir ama kimseye haber gitmez. Test bunu kilitliyor.
      "AccountFailureThreshold": 5,
      "DistinctAccountsFromIpThreshold": 3,
      "IpFailureThreshold": 20,
      "JustAfterLockoutMinutes": 5
    }
  },
  // Faz 12.2 — ters vekil arkasında GERÇEK istemci IP'si.
  // ⚠️ Enabled=true iken KnownProxies/KnownNetworks BOŞ BIRAKILAMAZ: istemci kendi
  // X-Forwarded-For başlığını uydurup güvenlik kaydını zehirler. Production'da
  // ProductionReadinessGuard bu kombinasyonu engeller.
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Fcm": {
    "Provider": "None",
    "ServiceAccountKeyPath": ""
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "PublicWrite": {
      "PermitLimit": 15,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://panel.kadirli.app"
    ]
  },
  "FileStorage": {
    "UploadDirectory": "../uploads",
    "BaseUrl": ""
  },
  // Faz 12.12 — haber alımı (WordPress). Projedeki ilk dış İÇERİK entegrasyonu.
  "News": {
    "Source": {
      "BaseUrl": "https://www.silagazetesi.com.tr/wp-json/wp/v2",
      // Kaynak tarafında tanınabilir olalım — trafiğimiz sorulursa cevabı olsun.
      "UserAgent": "KadirliApp-Sync/1.0",
      "TimeoutSeconds": 30,
      // Kaynak KARARSIZ: örneklemede canlıda 520 görüldü → üstel geri çekilmeli 3 deneme.
      "MaxAttempts": 3,
      "PageSize": 100,
      // Kaçak bir imlecin koşuyu saatlerce döndürmesini engelleyen tavan.
      "MaxPagesPerRun": 20
    },
    "Backfill": {
      // 🔑 Arşiv derinliği. Başlangıç 50 ("ilk başta test edeceğiz"). Büyütmek KOD DEĞİŞTİRMEZ:
      // geri imleç kaldığı yerden devam eder. ⚠️ 27.284'ün tamamı ≈ 273 istek + ~1,6 GB görsel.
      "MaxPosts": 50
    },
    "Images": {
      // Kapak görselleri aynalanır (kaynak kararsız + panelde CSP dış origine izin vermez).
      "Mirror": true,
      "MaxBytes": 2097152,
      "TimeoutSeconds": 30
    }
  },
  "Hangfire": {
    "Dashboard": {
      // Boş bırakılırsa /hangfire YALNIZ yerel isteklere açılır (geliştirme).
      // ⚠️ PRODUCTION'DA DOLDURULMALI: reverse-proxy arkasında her istek yerel görünür.
      "Username": "",
      "Password": ""
    }
  }
}
